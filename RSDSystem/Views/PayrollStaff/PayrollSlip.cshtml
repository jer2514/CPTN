@model RSDSystem.Models.Employee
@using System.Text.Json
@{
    ViewData["Title"] = "Generate Payroll Slip";
    Layout = "_PayrollStaffLayout";
    var project = ViewBag.Project as RSDSystem.Models.Project;
    var schedules = (ViewBag.Schedules as IEnumerable<RSDSystem.Models.PayrollSchedule>)?.ToList()
        ?? new List<RSDSystem.Models.PayrollSchedule>();
    var minDate = ViewBag.MinDate as string ?? "";
    var maxDate = ViewBag.MaxDate as string ?? "";
    var defaultStart = ViewBag.DefaultStart as string ?? "";
    var defaultEnd = ViewBag.DefaultEnd as string ?? "";
    var endMin = string.IsNullOrEmpty(defaultStart) ? minDate : defaultStart;
    var isEdit = ViewBag.IsEdit is true;
    var payrollId = ViewBag.PayrollId is int pid ? pid : 0;
    var payrollScheduleId = ViewBag.PayrollScheduleId is int sid ? sid : 0;
    var daysWorked = ViewBag.DefaultDaysWorked is int dw ? dw : 1;
    var absentDays = ViewBag.AbsentDays is int ad ? ad : 0;
    var overtimeHours = ViewBag.OvertimeHours is decimal ot ? ot : 0m;
    var regularHours = ViewBag.RegularHours is decimal rh ? rh : daysWorked * 8m;
    var cashAdvance = ViewBag.CashAdvance is decimal ca ? ca : 0m;
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
    var startLabel = DateTime.TryParse(defaultStart, out var startDt)
        ? startDt.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)
        : defaultStart;
    var endLabel = DateTime.TryParse(defaultEnd, out var endDt)
        ? endDt.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)
        : defaultEnd;
    var slipConfig = JsonSerializer.Serialize(new
    {
        employeeId = Model.EmployeeId,
        projectId = project?.ProjectId ?? 0,
        dailyRate = Model.DailyRate,
        hourlyRate = EmployeeRates.HourlyFromDaily(Model.DailyRate),
        boundMin = minDate,
        boundMax = maxDate,
        hasSchedule = ViewBag.HasPayrollSchedule is true,
        isEdit,
        payrollId,
        returnUrl,
        regularHours,
        overtimeHours,
        daysWorked,
        absentDays,
        schedules = schedules.Select(s => new
        {
            start = s.StartingDate.ToString("yyyy-MM-dd"),
            end = s.EndDate.ToString("yyyy-MM-dd")
        })
    });
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

@if (!string.IsNullOrEmpty(returnUrl))
{
    <a href="@returnUrl" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
}
else if (isEdit)
{
    <a asp-action="ViewPayroll" asp-route-id="@payrollId" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
}
else
{
    <a asp-action="GeneratePayroll" asp-route-projectId="@project?.ProjectId" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
}

<div class="slip-card">
    <div class="slip-title">@(isEdit ? "Edit Payroll Slip" : "Generate Payroll Slip")</div>

    <form id="payrollSlipForm" class="js-validate" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
        <input type="hidden" name="projectId" value="@project?.ProjectId" />
        <input type="hidden" name="payrollId" value="@payrollId" />
        <input type="hidden" name="payrollScheduleId" value="@payrollScheduleId" />

        <div class="slip-row3">
            <div>
                <div class="form-lbl">Employee ID</div>
                <div class="slip-value">@ViewBag.DisplayId</div>
            </div>
            <div>
                <div class="form-lbl">Employee Name</div>
                <div class="slip-value">@Model.FullName</div>
            </div>
            <div>
                <div class="form-lbl">Project Assigned</div>
                <div class="slip-value">@(project?.ProjectName ?? "—")</div>
            </div>
        </div>

        <div class="slip-row3">
            <div>
                <div class="form-lbl">Job Classification</div>
                <div class="slip-value">@Model.JobClassification</div>
            </div>
            <div>
                <div class="form-lbl">Rate per day</div>
                <div class="slip-value">₱@Model.DailyRate.ToString("N2")</div>
            </div>
            <div>
                <div class="form-lbl">Rate per hour</div>
                <div class="slip-value">₱@EmployeeRates.HourlyFromDaily(Model.DailyRate).ToString("N2")</div>
            </div>
        </div>

        <input type="hidden" name="payPeriodStart" id="payPeriodStart" value="@defaultStart" />
        <input type="hidden" name="payPeriodEnd" id="payPeriodEnd" value="@defaultEnd" />
        <input type="hidden" name="regularDaysWorked" id="regularDaysWorked" value="@daysWorked" />
        <input type="hidden" name="absentDays" id="absentDays" value="@absentDays" />
        <input type="hidden" name="overtimeHours" id="overtimeHours" value="@overtimeHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="regularHours" id="regularHours" value="@regularHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />

        @if (ViewBag.HasPayrollSchedule is true && (!string.IsNullOrEmpty(minDate) || !string.IsNullOrEmpty(maxDate)))
        {
            var scheduleStartLabel = !string.IsNullOrEmpty(minDate)
                ? DateTime.Parse(minDate).ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
                : "the schedule start";
            var scheduleEndLabel = !string.IsNullOrEmpty(maxDate)
                ? DateTime.Parse(maxDate).ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
                : "the schedule end";
            <div class="slip-schedule-hint" id="payPeriodScheduleHint">
                Pay period is taken from the payroll schedule:
                @scheduleStartLabel – @scheduleEndLabel
            </div>
        }
        else
        {
            <div class="slip-schedule-hint slip-schedule-hint-warn" id="payPeriodScheduleHint">
                A payroll schedule must be added by the admin before generating payroll.
            </div>
        }

        <div class="form-row form-row-2">
            <div>
                <div class="form-lbl">Pay Period Starting Date</div>
                <div class="slip-value">@startLabel</div>
            </div>
            <div>
                <div class="form-lbl">Pay Period Ending Date</div>
                <div class="slip-value">@endLabel</div>
            </div>
        </div>
        <div class="form-row form-row-2">
            <div>
                <div class="form-lbl">Regular Days Worked</div>
                <div class="slip-value">@daysWorked</div>
            </div>
            <div>
                <div class="form-lbl">Regular Hours</div>
                <div class="slip-value">@regularHours.ToString("0.##")</div>
            </div>
        </div>
        <div class="form-row form-row-2">
            <div>
                <div class="form-lbl">Absent Days</div>
                <div class="slip-value">@absentDays</div>
            </div>
            <div>
                <div class="form-lbl">Overtime (Hours)</div>
                <div class="slip-value">@overtimeHours.ToString("0.##")</div>
            </div>
        </div>

        <div class="slip-generate-row">
            <div>
                <label class="form-lbl">Cash Advance</label>
                <input type="number" name="cashAdvance" id="cashAdvance" class="form-ctrl"
                       step="0.01" min="0" value="@cashAdvance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                       data-validate="nonNeg" data-label="Cash advance" readonly />
                <span class="field-error" data-error-for="cashAdvance"></span>
                <div class="form-hint-box" style="margin-top:8px">
                    <i class="bi bi-info-circle-fill"></i>
                    Filled from cash advances the admin marked for this payroll.
                </div>
            </div>
            <button type="submit" id="generateBtn" class="btn-primary-blue-block"
                    @(ViewBag.HasPayrollSchedule is true ? null : "disabled")>
                @(isEdit ? "Save Changes" : "Generate Payroll")
            </button>
        </div>
    </form>
</div>

<!-- Success Confirmation Modal -->
<div class="del-overlay" id="successOverlay">
    <div class="del-modal">
        <div class="del-icon-wrap" style="background:#d4f7e0">
            <i class="bi bi-check-circle-fill" style="color:#0d7a3e;font-size:28px"></i>
        </div>
        <div class="del-title">Saved</div>
        <div class="del-msg" id="successMsg">Payroll has been saved.</div>
        <div class="del-actions">
            <button class="del-btn-delete" style="background:#266DF1" id="successOkBtn">OK</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script type="application/json" id="slip-config">@Html.Raw(slipConfig)</script>
    <script src="~/js/payroll-slip.js" asp-append-version="true"></script>
}
