@model List<RSDSystem.Models.Project>
@{
    ViewData["Title"] = "Pending Payroll";
    Layout = "_PayrollStaffLayout";
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card search-stretch-card">
    <div class="emp-title mb-3">Pending Payroll</div>

    @if (ViewBag.ShowingAllProjects == true)
    {
        <div class="genpay-fallback-note">
            Showing all active projects — none are currently assigned to your account specifically.
        </div>
    }

    <div class="genpay-controls">
        <div class="genpay-select-wrap">
            <label class="form-lbl">Project Name</label>
            <div class="genpay-autocomplete">
                <input type="text" id="projectInput" class="form-ctrl"
                       placeholder="Type to search project..." autocomplete="off" />
                <input type="hidden" id="projectIdInput" />
                <ul id="projectSuggestions" class="genpay-suggest-list"></ul>
            </div>
        </div>
        <button type="button" id="loadPayrollsBtn" class="btn-primary-blue-solid">Load</button>
    </div>

    <div id="payrollSection" style="display:none">
        <div class="list-controls-row att-list-toolbar">
            <div class="list-controls-left">
                <div class="search-wrap search-wrap-wide">
                    <i class="bi bi-search"></i>
                    <input type="text" id="payrollSearch" placeholder="Search Employee" oninput="filterPayrolls()" />
                </div>
                <div class="dropdown">
                    <button type="button" class="btn-outline-blue dropdown-toggle filter-label-btn"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        All
                    </button>
                    <ul class="dropdown-menu filter-menu">
                        <li><button type="button" class="dropdown-item active" data-sort="all">All</button></li>
                        <li><button type="button" class="dropdown-item" data-sort="lastname">Last Name</button></li>
                        <li><button type="button" class="dropdown-item" data-sort="status">Status</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <table class="emp-table">
            <thead>
                <tr>
                    <th>Employee ID</th>
                    <th>Employee Name</th>
                    <th>Job</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="payrollTableBody"></tbody>
        </table>
        <div id="payrollPager" class="att-pager" style="margin-top:18px"></div>
    </div>

    <div id="payrollEmpty" class="text-center text-muted py-5">
        Select a project and click Load to view its payroll records.
    </div>
</div>

@section Scripts {
    <partial name="_ProjectListData" model="Model" />
    <script>
        const projectsEl = document.getElementById('project-list-data');
        const allProjects = JSON.parse(projectsEl && projectsEl.textContent ? projectsEl.textContent : '[]');

        const projectInput   = document.getElementById('projectInput');
        const projectIdInput = document.getElementById('projectIdInput');
        const suggestList    = document.getElementById('projectSuggestions');

        function renderSuggestions(matches) {
            if (matches.length === 0) {
                suggestList.innerHTML = '<li class="genpay-suggest-empty">No matching project</li>';
                suggestList.style.display = 'block';
                return;
            }
            suggestList.innerHTML = matches.map(p =>
                `<li data-id="${p.id}" data-name="${p.name.replace(/"/g, '&quot;')}">${p.name}</li>`
            ).join('');
            suggestList.style.display = 'block';
        }

        projectInput.addEventListener('input', function () {
            projectIdInput.value = '';
            const q = projectInput.value.trim().toLowerCase();
            if (!q) { suggestList.style.display = 'none'; return; }
            renderSuggestions(allProjects.filter(p => p.name.toLowerCase().includes(q)));
        });

        projectInput.addEventListener('focus', function () {
            const q = projectInput.value.trim().toLowerCase();
            renderSuggestions(q ? allProjects.filter(p => p.name.toLowerCase().includes(q)) : allProjects);
        });

        suggestList.addEventListener('click', function (e) {
            const li = e.target.closest('li[data-id]');
            if (!li) return;
            projectInput.value = li.dataset.name;
            projectIdInput.value = li.dataset.id;
            suggestList.style.display = 'none';
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.genpay-autocomplete')) suggestList.style.display = 'none';
        });

        const pageSize = 10;
        let currentPayrolls = [];
        let currentProjectId = null;
        let currentPage = 1;
        let payrollSort = 'all';

        document.getElementById('loadPayrollsBtn').addEventListener('click', loadPayrolls);

        async function loadPayrolls() {
            if (!projectIdInput.value) {
                showToast('Please select a project from the suggestion list.');
                return;
            }
            currentProjectId = projectIdInput.value;

            const emptyBox = document.getElementById('payrollEmpty');
            const section  = document.getElementById('payrollSection');

            section.style.display = 'none';
            emptyBox.style.display = 'block';
            emptyBox.textContent = 'Loading payroll records...';

            try {
                const res  = await fetch('/PayrollStaff/GetProjectPayrolls?projectId=' + currentProjectId);
                const data = await res.json();

                if (!data.success) { emptyBox.textContent = data.message; return; }

                currentPayrolls = data.payrolls;

                if (currentPayrolls.length === 0) {
                    emptyBox.textContent = 'No payroll records for this project yet.';
                    return;
                }

                emptyBox.style.display = 'none';
                section.style.display = 'block';
                currentPage = 1;
                payrollSort = 'all';
                document.querySelectorAll('.filter-menu [data-sort]').forEach(function (item) {
                    item.classList.toggle('active', item.dataset.sort === 'all');
                });
                if (typeof setFilterButtonLabel === 'function')
                    setFilterButtonLabel(document.querySelector('#payrollSection .filter-label-btn'), 'All');
                renderPayrolls();
            } catch (err) {
                emptyBox.textContent = 'Something went wrong while loading payroll records.';
            }
        }

        function statusClass(status) {
            if (status === 'Correction') return 'row-correction';
            if (status === 'Draft') return 'row-draft';
            if (status === 'Submitted') return 'row-submitted';
            return '';
        }

        // Draft -> Submit, View, Delete
        // Correction -> Submit, View
        // Submitted / Approved -> View only
        function actionButtons(p) {
            const status = (p.status || '').trim();
            let btns = '';

            if (status === 'Draft' || status === 'Correction') {
                btns += `<button type="button" class="pill-btn pill-submit" onclick="confirmSubmit(${p.payrollId})">Submit</button>`;
            }

            btns += `<a class="pill-btn pill-view" href="/PayrollStaff/ViewPayroll/${p.payrollId}">View</a>`;
            if (status === 'Draft') {
                btns += `<button type="button" class="pill-btn pill-delete" onclick="confirmDelete(${p.payrollId})">Delete</button>`;
            }
            return btns;
        }

        function payrollLastName(p) {
            return (p.lastName || (p.employeeName || '').trim().split(/\s+/).pop() || '').toLowerCase();
        }

        function filteredPayrolls() {
            const q = document.getElementById('payrollSearch').value.toLowerCase();
            let list = currentPayrolls.filter(p =>
                !q ||
                (p.employeeName || '').toLowerCase().includes(q) ||
                (p.job || '').toLowerCase().includes(q) ||
                (p.displayId || '').toLowerCase().includes(q));
            if (payrollSort === 'lastname') {
                list = [...list].sort((a, b) => payrollLastName(a).localeCompare(payrollLastName(b)));
            } else if (payrollSort === 'status') {
                list = [...list].sort((a, b) => (a.status || '').localeCompare(b.status || ''));
            }
            return list;
        }

        function renderPager(totalPages) {
            const pager = document.getElementById('payrollPager');
            if (!pager) return;
            if (totalPages < 1) {
                pager.innerHTML = '';
                return;
            }
            pager.innerHTML =
                `<button type="button" class="att-page-btn" data-dir="-1" ${currentPage <= 1 ? 'disabled' : ''}>&lsaquo;</button>` +
                `<span>Page ${currentPage} of ${totalPages}</span>` +
                `<button type="button" class="att-page-btn" data-dir="1" ${currentPage >= totalPages ? 'disabled' : ''}>&rsaquo;</button>`;
        }

        function renderPayrolls() {
            const tbody = document.getElementById('payrollTableBody');
            const list = filteredPayrolls();

            if (!list.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No payroll records match your search.
                        </td>
                    </tr>`;
                renderPager(0);
                return;
            }

            const totalPages = Math.max(1, Math.ceil(list.length / pageSize));
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const pageItems = list.slice((currentPage - 1) * pageSize, currentPage * pageSize);

            tbody.innerHTML = pageItems.map(p => `
                <tr class="${statusClass(p.status)}">
                    <td>${p.displayId}</td>
                    <td>${p.employeeName}</td>
                    <td>${p.job}</td>
                    <td>${p.period || '—'}</td>
                    <td><span class="status-pill status-${(p.status || '').toLowerCase()}">${p.status}</span></td>
                    <td>
                        <div class="action-cell">
                            ${actionButtons(p)}
                        </div>
                    </td>
                </tr>`).join('');

            renderPager(totalPages);
        }

        function filterPayrolls() {
            currentPage = 1;
            renderPayrolls();
        }

        document.querySelectorAll('.filter-menu [data-sort]').forEach(function (el) {
            el.addEventListener('click', function () {
                payrollSort = this.dataset.sort || 'all';
                document.querySelectorAll('.filter-menu [data-sort]').forEach(function (item) {
                    item.classList.toggle('active', item.dataset.sort === payrollSort);
                });
                currentPage = 1;
                renderPayrolls();
            });
        });

        document.getElementById('payrollPager').addEventListener('click', function (e) {
            const btn = e.target.closest('[data-dir]');
            if (!btn || btn.disabled) return;
            const list = filteredPayrolls();
            const totalPages = Math.max(1, Math.ceil(list.length / pageSize));
            const next = currentPage + Number(btn.dataset.dir);
            if (next < 1 || next > totalPages) return;
            currentPage = next;
            renderPayrolls();
        });

        function getToken() {
            return document.querySelector('#submitTokenForm input[name="__RequestVerificationToken"]').value;
        }

        // ── Submit confirmation ─────────────────────────────────────
        let pendingSubmitId = null;

        function confirmSubmit(payrollId) {
            pendingSubmitId = payrollId;
            document.getElementById('submitOverlay').classList.add('open');
        }

        document.getElementById('submitCancelBtn').addEventListener('click', function () {
            document.getElementById('submitOverlay').classList.remove('open');
            pendingSubmitId = null;
        });

        document.getElementById('submitConfirmBtn').addEventListener('click', async function () {
            if (!pendingSubmitId) return;

            const form = new FormData();
            form.append('id', pendingSubmitId);
            form.append('__RequestVerificationToken', getToken());

            try {
                const res  = await fetch('/PayrollStaff/SubmitPayroll/' + pendingSubmitId, { method: 'POST', body: form });
                const data = await res.json();

                document.getElementById('submitOverlay').classList.remove('open');

                if (data.success) {
                    loadPayrolls(); // refresh list so status/order updates
                } else {
                    showToast(data.message || 'Failed to submit payroll.');
                }
            } catch (err) {
                document.getElementById('submitOverlay').classList.remove('open');
                showToast('Something went wrong.');
            }

            pendingSubmitId = null;
        });

        let pendingDeleteId = null;

        function confirmDelete(payrollId) {
            pendingDeleteId = payrollId;
            const row = currentPayrolls.find(p => p.payrollId === payrollId);
            const name = (row && row.employeeName) || 'this employee';
            const status = ((row && row.status) || 'payroll').toLowerCase();
            document.getElementById('deleteTitle').textContent = 'Delete Payroll?';
            document.getElementById('deleteMsg').textContent =
                `This will permanently remove ${name}'s ${status} payroll record. This action cannot be undone.`;
            document.getElementById('deleteOverlay').classList.add('open');
        }

        document.getElementById('deleteCancelBtn').addEventListener('click', function () {
            document.getElementById('deleteOverlay').classList.remove('open');
            pendingDeleteId = null;
        });

        document.getElementById('deleteConfirmBtn').addEventListener('click', async function () {
            if (!pendingDeleteId) return;

            const form = new FormData();
            form.append('id', pendingDeleteId);
            form.append('__RequestVerificationToken', getToken());

            try {
                const res  = await fetch('/PayrollStaff/DeletePayroll/' + pendingDeleteId, { method: 'POST', body: form });
                const data = await res.json();

                document.getElementById('deleteOverlay').classList.remove('open');

                if (data.success) {
                    loadPayrolls();
                } else {
                    showToast(data.message || 'Failed to delete payroll.');
                }
            } catch (err) {
                document.getElementById('deleteOverlay').classList.remove('open');
                showToast('Something went wrong.');
            }

            pendingDeleteId = null;
        });

        // ── Restore project on Back navigation ─────────────────────
        const preselectId = @(ViewBag.PreselectProjectId != null ? ViewBag.PreselectProjectId : "null");
        if (preselectId) {
            const match = allProjects.find(p => p.id === preselectId);
            if (match) {
                projectInput.value = match.name;
                projectIdInput.value = match.id;
                loadPayrolls();
            }
        }
    </script>

    <form id="submitTokenForm" style="display:none">
        @Html.AntiForgeryToken()
    </form>
}

<!-- Submit Confirmation Modal -->
<div class="del-overlay" id="submitOverlay">
    <div class="del-modal">
        <div class="del-icon-wrap" style="background:#dbeafe">
            <i class="bi bi-send-fill" style="color:#266DF1;font-size:24px"></i>
        </div>
        <div class="del-title">Submit Payroll?</div>
        <div class="del-msg">
            This payroll record will be sent to the admin for review and approval.
        </div>
        <div class="del-actions">
            <button class="del-btn-cancel" id="submitCancelBtn">Cancel</button>
            <button class="del-btn-delete" style="background:#266DF1" id="submitConfirmBtn">Submit</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="del-overlay" id="deleteOverlay">
    <div class="del-modal">
        <div class="del-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill del-icon"></i>
        </div>
        <div class="del-title" id="deleteTitle">Delete Payroll?</div>
        <div class="del-msg" id="deleteMsg">
            This payroll record will be permanently deleted. This action cannot be undone.
        </div>
        <div class="del-actions">
            <button class="del-btn-cancel" id="deleteCancelBtn">Cancel</button>
            <button class="del-btn-delete" id="deleteConfirmBtn">Delete</button>
        </div>
    </div>
</div>