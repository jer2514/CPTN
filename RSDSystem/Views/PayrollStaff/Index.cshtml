@model List<RSDSystem.Models.PayrollSchedule>
@{
    ViewData["Title"] = "To do task";
    Layout = "_PayrollStaffLayout";
}

<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card task-page-card">
    <div class="task-card-title">To do task</div>

    <table class="task-table">
        <thead>
            <tr>
                <th>Project Name</th>
                <th>Type of Project</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Mark as Done</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="task-empty">No tasks assigned.</td>
                </tr>
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td>@(s.Project?.ProjectName ?? "—")</td>
                    <td>@(s.TypeOfService ?? s.Project?.TypeOfService ?? "—")</td>
                    <td>@s.StartingDate.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@s.EndDate.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>
                        <form asp-action="ToggleTask" asp-route-id="@s.PayrollScheduleId" method="post" class="task-check-form">
                            @Html.AntiForgeryToken()
                            @if (s.TaskCompleted)
                            {
                                <input type="checkbox" class="tbl-check" title="Mark as done" checked
                                       onchange="this.form.submit()" />
                            }
                            else
                            {
                                <input type="checkbox" class="tbl-check" title="Mark as done"
                                       onchange="this.form.submit()" />
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
