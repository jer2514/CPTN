@*
    Admin and Staff: NotificationController.Index. Full bell list with paging; mark all as
    read. Admin can open attendance-correction and task-done modals from a row.
*@
@model List<RSDSystem.Models.AppNotification>
@using RSDSystem.Services
@{
    ViewData["Title"] = "Notifications";
    var role = Context.Session.GetString("Role");
    Layout = role == "PayrollStaff" ? "_PayrollStaffLayout" : "_Layout";
    var currentPage = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var backController = role == "PayrollStaff" ? "PayrollStaff" : "Home";
}

<div class="content-topbar">
    <a asp-controller="@backController" asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <button type="button" class="bell-btn" aria-label="Notifications"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card notif-page-card">
    <div class="notif-page-title">Notifications</div>

    <div class="notif-filter-bar">
        <span class="notif-filter-active">All</span>
        <button type="button" class="notif-mark-all" id="notifPageMarkAll">mark all as read</button>
    </div>

    <div class="notif-page-list">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center text-muted py-5">No notifications yet.</div>
        }
        else
        {
            foreach (var item in Model)
            {
                var url = item.Url ?? "#";
                var correction = isAdmin && item.Kind == RSDSystem.Models.NotificationKinds.AttendanceCorrectionRequest && item.RelatedId.HasValue;
                var task = isAdmin && item.Kind == RSDSystem.Models.NotificationKinds.TaskCompletionRequested && item.RelatedId.HasValue;
                <button type="button"
                        class="notif-page-item @(item.IsRead ? "is-read" : "")"
                        data-id="@item.AppNotificationId"
                        data-url="@url"
                        data-kind="@item.Kind"
                        data-related="@(item.RelatedId?.ToString() ?? "")"
                        data-correction="@(correction ? "1" : "0")"
                        data-task="@(task ? "1" : "0")">
                    <span class="notif-icon @RSDSystem.Models.NotificationKinds.IconClass(item.Kind)">
                        <i class="bi @RSDSystem.Models.NotificationKinds.Icon(item.Kind)"></i>
                    </span>
                    <span class="notif-page-copy">
                        <span class="notif-item-top">
                            <span class="notif-item-title">@item.Title</span>
                            <span class="notif-item-time">@NotificationService.RelativeTime(item.CreatedAt)</span>
                        </span>
                        <span class="notif-item-msg">@item.Message</span>
                    </span>
                    @if (!item.IsRead)
                    {
                        <span class="notif-unread-dot"></span>
                    }
                </button>
            }
        }
    </div>

    <div class="notif-pager">
        @if (currentPage > 1)
        {
            <a class="att-page-btn" asp-action="Index" asp-route-page="@(currentPage - 1)">&lsaquo;</a>
        }
        else
        {
            <button type="button" class="att-page-btn" disabled>&lsaquo;</button>
        }
        <span>Page @currentPage of @totalPages</span>
        @if (currentPage < totalPages)
        {
            <a class="att-page-btn" asp-action="Index" asp-route-page="@(currentPage + 1)">&rsaquo;</a>
        }
        else
        {
            <button type="button" class="att-page-btn" disabled>&rsaquo;</button>
        }
    </div>
</div>
