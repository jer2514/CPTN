@model List<RSDSystem.Models.Project>
@{
    ViewData["Title"] = "Attendance Records";
    var isAdmin = ViewBag.IsAdmin is true
        || string.Equals(Context.Session.GetString("Role"), "Admin", StringComparison.OrdinalIgnoreCase);
    Layout = isAdmin ? "_Layout" : "_PayrollStaffLayout";
}

<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card">
    <div class="att-page-title">Attendance Records</div>

    @if (ViewBag.ShowingAllProjects == true)
    {
        <div class="genpay-fallback-note">
            Showing all active projects — none are currently assigned to your account specifically.
        </div>
    }

    <div class="att-filter-grid">
        <div class="att-field">
            <label class="form-lbl">Project Name</label>
            <div class="att-field-controls">
                <div class="genpay-autocomplete att-grow">
                    <input type="text" id="projectInput" class="form-ctrl"
                           placeholder="Type to search project..." autocomplete="off" />
                    <input type="hidden" id="projectIdInput" />
                    <ul id="projectSuggestions" class="genpay-suggest-list"></ul>
                </div>
                <button type="button" id="projectLoadBtn" class="btn-primary-blue-solid">Load</button>
            </div>
        </div>
        <div class="att-field">
            <label class="form-lbl">Period</label>
            <div class="att-field-controls">
                <select id="periodSelect" class="form-ctrl att-grow">
                    <option value="">Select a project first</option>
                </select>
                <button type="button" id="periodLoadBtn" class="btn-primary-blue-solid">Load</button>
            </div>
        </div>
    </div>

    <div id="recordsSection" style="display:none">
        <div class="emp-card-head" style="margin-top:6px">
            <div id="recordsMeta" class="att-preview-meta"></div>
            <div class="emp-controls">
                <div class="dropdown">
                    <button class="btn-outline-blue dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <ul class="dropdown-menu filter-menu">
                        <li><button type="button" class="dropdown-item" data-status="all">All</button></li>
                        <li><button type="button" class="dropdown-item" data-status="Complete">Complete</button></li>
                        <li><button type="button" class="dropdown-item" data-status="Half-day">Half-day</button></li>
                        <li><button type="button" class="dropdown-item" data-status="Late">Late</button></li>
                        <li><button type="button" class="dropdown-item" data-status="Early Off">Early Off</button></li>
                        <li><button type="button" class="dropdown-item" data-status="Absent">Absent</button></li>
                    </ul>
                </div>
                <div class="search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" id="rowSearch" placeholder="Search User" />
                </div>
            </div>
        </div>

        <div class="att-table-wrap">
            <table class="emp-table att-table">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Date</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Overtime In</th>
                        <th>Overtime Out</th>
                        <th>Status</th>
                        @if (!isAdmin)
                        {
                            <th>Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="recordsBody"></tbody>
            </table>
        </div>

        <div class="att-preview-footer att-records-footer">
            <div class="att-footer-spacer"></div>
            <div id="recordsPager" class="att-pager"></div>
            <div class="att-footer-actions"></div>
        </div>
    </div>

    <div id="recordsEmpty" class="text-center text-muted py-5">
        Select a project and click Load, then choose a period.
    </div>
</div>

@if (!isAdmin)
{
<div id="recordEditOverlay" class="att-edit-overlay" hidden>
    <div class="page-card att-edit-panel">
        <div class="att-page-title" id="recordEditTitle">Request Edit</div>
        <div class="att-edit-sub">Morning 8:00–12:00 · Afternoon 13:00–17:00 · Overtime from 17:00. Late after 8:30. Early out before 16:45.</div>
        <div class="att-edit-meta">
            <div>
                <div class="form-lbl">Employee ID</div>
                <div class="slip-value" id="reDisplayId"></div>
            </div>
            <div>
                <div class="form-lbl">Employee Name</div>
                <div class="slip-value" id="reName"></div>
            </div>
            <div>
                <div class="form-lbl">Date</div>
                <div class="slip-value" id="reDate"></div>
            </div>
            <div>
                <div class="form-lbl">Status</div>
                <span class="status-pill" id="reStatus">Absent</span>
            </div>
        </div>
        <div class="att-edit-grid">
            <label>Before Noon In<input type="time" id="reIn1" class="form-ctrl" /></label>
            <label>Before Noon Out<input type="time" id="reOut1" class="form-ctrl" /></label>
            <label>After Noon In<input type="time" id="reIn2" class="form-ctrl" /></label>
            <label>After Noon Out<input type="time" id="reOut2" class="form-ctrl" /></label>
            <label>Overtime In<input type="time" id="reOtIn" class="form-ctrl" /></label>
            <label>Overtime Out<input type="time" id="reOtOut" class="form-ctrl" /></label>
        </div>
        <label id="reReasonWrap" class="form-lbl" style="display:block;margin-top:12px">
            Reason
            <input type="text" id="reReason" class="form-ctrl" placeholder="Half-day attendance" maxlength="250" />
        </label>
        <div class="att-edit-live" id="reHours">0.00 regular hours · 0.00 overtime</div>
        <div class="att-preview-footer">
            <div class="att-edit-actions">
                <button type="button" class="att-quick-btn" id="reStandard">8–5</button>
                <button type="button" class="att-quick-btn" id="reClear">Clear</button>
            </div>
            <div class="att-edit-actions">
                <button type="button" class="btn-outline-blue" id="reCancel">Cancel</button>
                <button type="button" class="btn-primary-blue-solid" id="reSave">Save</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
    <partial name="_ProjectListData" model="Model" />
    <form id="__afToken" style="display:none">@Html.AntiForgeryToken()</form>
    <script>
        const isAdmin = @(isAdmin ? "true" : "false");
        const projectsEl = document.getElementById('project-list-data');
        const allProjects = JSON.parse(projectsEl && projectsEl.textContent ? projectsEl.textContent : '[]');

        const projectInput = document.getElementById('projectInput');
        const projectIdInput = document.getElementById('projectIdInput');
        const suggestList = document.getElementById('projectSuggestions');
        const periodSelect = document.getElementById('periodSelect');
        let statusFilter = 'all';
        let currentPage = 1;
        let loadedPeriod = null;
        let lastRows = [];

        function renderSuggestions(matches) {
            if (matches.length === 0) {
                suggestList.innerHTML = '<li class="genpay-suggest-empty">No matching project</li>';
                suggestList.style.display = 'block';
                return;
            }
            suggestList.innerHTML = matches.map(p =>
                `<li data-id="${p.id}" data-name="${p.name.replace(/"/g, '&quot;')}">${p.name}</li>`
            ).join('');
            suggestList.style.display = 'block';
        }

        projectInput.addEventListener('input', function () {
            projectIdInput.value = '';
            const q = projectInput.value.trim().toLowerCase();
            if (!q) { suggestList.style.display = 'none'; return; }
            renderSuggestions(allProjects.filter(p => p.name.toLowerCase().includes(q)));
        });
        projectInput.addEventListener('focus', function () {
            const q = projectInput.value.trim().toLowerCase();
            renderSuggestions(q ? allProjects.filter(p => p.name.toLowerCase().includes(q)) : allProjects);
        });
        suggestList.addEventListener('click', function (e) {
            const li = e.target.closest('li[data-id]');
            if (!li) return;
            projectInput.value = li.dataset.name;
            projectIdInput.value = li.dataset.id;
            suggestList.style.display = 'none';
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.genpay-autocomplete')) suggestList.style.display = 'none';
        });

        const tokenInput = document.querySelector('#__afToken input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        const filterBtn = document.querySelector('.emp-controls .dropdown-toggle');
        const statusClass = {
            Complete: 'att-status-complete',
            Incomplete: 'att-status-halfday',
            'Half-day': 'att-status-halfday',
            Late: 'att-status-late',
            'Early Off': 'att-status-early',
            'Late + Early Off': 'att-status-late',
            Absent: 'att-status-absent'
        };
        let editingRecord = null;

        document.querySelectorAll('.filter-menu [data-status]').forEach(el => {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                statusFilter = this.dataset.status || 'all';
                if (filterBtn) {
                    filterBtn.innerHTML = statusFilter === 'all'
                        ? '<i class="bi bi-funnel"></i> Filter'
                        : '<i class="bi bi-funnel"></i> ' + statusFilter;
                }
                currentPage = 1;
                if (selectedPeriod()) loadRecords();
            });
        });
        document.getElementById('rowSearch').addEventListener('input', function () {
            if (!selectedPeriod()) return;
            currentPage = 1;
            loadRecords();
        });

        function dash(v) {
            return v == null || v === '' || v === '—' ? '——' : v;
        }

        function timeCell(v) {
            const text = dash(v);
            return text === '——' ? `<span class="att-empty">${text}</span>` : text;
        }

        function selectedPeriod() {
            const value = periodSelect.value;
            if (!value || !value.includes('|')) return null;
            const parts = value.split('|');
            return { start: parts[0], end: parts[1], label: periodSelect.options[periodSelect.selectedIndex].text };
        }

        function resetPeriods(message) {
            periodSelect.innerHTML = `<option value="">${message}</option>`;
            loadedPeriod = null;
        }

        async function loadPeriods(autoLoadRecords) {
            if (!projectIdInput.value) {
                showToast('Please select a project from the suggestion list.');
                return;
            }

            const empty = document.getElementById('recordsEmpty');
            const section = document.getElementById('recordsSection');
            empty.style.display = 'block';
            section.style.display = 'none';
            empty.textContent = 'Loading imported periods...';

            try {
                const res = await fetch(`/Attendance/GetPeriods?projectId=${projectIdInput.value}`);
                const data = await res.json();
                if (!data.success) { empty.textContent = data.message; resetPeriods('No imported periods'); return; }
                if (!data.periods.length) {
                    resetPeriods('No imported periods');
                    empty.textContent = 'Payroll staff have not imported attendance for this project yet.';
                    return;
                }

                periodSelect.innerHTML = data.periods.map(p =>
                    `<option value="${p.start}|${p.end}">${p.label}</option>`
                ).join('');
                empty.textContent = 'Select a period and click Load.';
                if (autoLoadRecords) {
                    currentPage = 1;
                    await loadRecords();
                }
            } catch (err) {
                empty.textContent = 'Could not load imported periods.';
                resetPeriods('Select a project first');
            }
        }

        async function loadRecords() {
            if (!projectIdInput.value) {
                showToast('Please select a project from the suggestion list.');
                return;
            }

            const period = selectedPeriod();
            if (!period) {
                document.getElementById('recordsEmpty').textContent = 'Select a period and click Load.';
                document.getElementById('recordsSection').style.display = 'none';
                document.getElementById('recordsEmpty').style.display = 'block';
                return;
            }

            const empty = document.getElementById('recordsEmpty');
            const section = document.getElementById('recordsSection');
            const q = encodeURIComponent(document.getElementById('rowSearch').value.trim());
            const url = `/Attendance/GetRecords?projectId=${projectIdInput.value}&search=${q}&status=${encodeURIComponent(statusFilter)}&page=${currentPage}&periodStart=${period.start}&periodEnd=${period.end}`;

            if (section.style.display === 'none') {
                empty.style.display = 'block';
                empty.textContent = 'Loading attendance records...';
            }

            try {
                const res = await fetch(url);
                const data = await res.json();
                if (!data.success) { empty.textContent = data.message; return; }

                loadedPeriod = period;
                lastRows = data.rows || [];
                const byline = data.importedBy ? ` · Imported by ${data.importedBy}` : '';
                const filterNote = statusFilter !== 'all' ? ` · ${statusFilter}` : '';
                document.getElementById('recordsMeta').textContent =
                    `${data.projectName} · ${data.periodLabel || period.label} · ${data.total} row(s)${filterNote}${byline}`;
                document.getElementById('recordsBody').innerHTML = data.rows.length
                    ? data.rows.map(r => {
                        const action = isAdmin ? '' : (() => {
                            const actionLabel = r.actionLabel || (r.status === 'Complete' ? 'Request Edit' : 'Edit');
                            return `<td><button type="button" class="att-action-link" data-record-id="${r.recordId}">${actionLabel}</button></td>`;
                        })();
                        return `<tr class="${r.matched ? '' : 'att-row-unmatched'}">
                            <td>${r.displayId || '——'}</td>
                            <td>${r.employeeName || '——'}</td>
                            <td>${dash(r.workDate)}</td>
                            <td>${timeCell(r.timeIn1)}</td>
                            <td>${timeCell(r.timeOut1)}</td>
                            <td>${timeCell(r.timeIn2)}</td>
                            <td>${timeCell(r.timeOut2)}</td>
                            <td>${timeCell(r.overtimeIn)}</td>
                            <td>${timeCell(r.overtimeOut)}</td>
                            <td><span class="status-pill ${r.statusClass}">${r.status}</span></td>
                            ${action}
                        </tr>`;
                    }).join('')
                    : `<tr><td colspan="${isAdmin ? 10 : 11}" class="text-center text-muted py-4">No attendance rows match this filter.</td></tr>`;

                document.getElementById('recordsPager').innerHTML =
                    `<button type="button" class="att-page-btn" ${data.page <= 1 ? 'disabled' : ''} data-dir="-1">&lsaquo;</button>
                     <span>Page ${data.page} of ${data.totalPages}</span>
                     <button type="button" class="att-page-btn" ${data.page >= data.totalPages ? 'disabled' : ''} data-dir="1">&rsaquo;</button>`;

                empty.style.display = 'none';
                section.style.display = 'block';
            } catch (err) {
                empty.textContent = 'Could not load attendance records.';
            }
        }

        document.getElementById('projectLoadBtn').addEventListener('click', function () {
            currentPage = 1;
            loadPeriods(true);
        });
        document.getElementById('periodLoadBtn').addEventListener('click', function () {
            currentPage = 1;
            loadRecords();
        });

        document.getElementById('recordsPager').addEventListener('click', function (e) {
            const btn = e.target.closest('[data-dir]');
            if (!btn || btn.disabled) return;
            currentPage += Number(btn.dataset.dir);
            loadRecords();
        });

        function toHtmlTime(value) {
            if (!value || value === '——') return '';
            const text = String(value).trim();
            const ampm = text.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
            if (ampm) {
                let hour = parseInt(ampm[1], 10);
                const minute = ampm[2];
                const period = ampm[3].toUpperCase();
                if (period === 'AM' && hour === 12) hour = 0;
                if (period === 'PM' && hour < 12) hour += 12;
                return String(hour).padStart(2, '0') + ':' + minute;
            }
            const military = text.match(/^(\d{1,2}):(\d{2})/);
            return military ? String(military[1]).padStart(2, '0') + ':' + military[2] : '';
        }

        function fromHtmlTime(value) {
            if (!value) return '';
            const parts = String(value).split(':');
            const hour = parseInt(parts[0], 10);
            const minute = parts[1] || '00';
            const period = hour >= 12 ? 'PM' : 'AM';
            let display = hour % 12;
            if (display === 0) display = 12;
            return display + ':' + minute + ' ' + period;
        }

        function minutesOf(value) {
            const html = toHtmlTime(value);
            if (!html) return null;
            const parts = html.split(':');
            return (parseInt(parts[0], 10) * 60) + parseInt(parts[1], 10);
        }

        function overlapHours(timeIn, timeOut, winStart, winEnd) {
            const start = minutesOf(timeIn);
            const end = minutesOf(timeOut);
            if (start === null || end === null) return 0;
            let to = end < start ? end + 24 * 60 : end;
            const from = Math.max(start, winStart);
            const until = Math.min(to, winEnd);
            if (until <= from) return 0;
            return Math.round(((until - from) / 60) * 100) / 100;
        }

        function draftHours(draft) {
            const morning = overlapHours(draft.timeIn1, draft.timeOut1, 8 * 60, 12 * 60)
                + overlapHours(draft.timeIn2, draft.timeOut2, 8 * 60, 12 * 60);
            const afternoon = overlapHours(draft.timeIn1, draft.timeOut1, 13 * 60, 17 * 60)
                + overlapHours(draft.timeIn2, draft.timeOut2, 13 * 60, 17 * 60);
            const punchedOt = overlapHours(draft.overtimeIn, draft.overtimeOut, 17 * 60, 24 * 60);
            const shiftOt = overlapHours(draft.timeIn1, draft.timeOut1, 17 * 60, 24 * 60)
                + overlapHours(draft.timeIn2, draft.timeOut2, 17 * 60, 24 * 60);
            return { regular: Math.round((morning + afternoon) * 100) / 100, ot: punchedOt > 0 ? punchedOt : shiftOt };
        }

        function draftStatus(draft) {
            const hasIn1 = !!draft.timeIn1;
            const hasOut1 = !!draft.timeOut1;
            const hasIn2 = !!draft.timeIn2;
            const hasOut2 = !!draft.timeOut2;
            const hasOtIn = !!draft.overtimeIn;
            const hasOtOut = !!draft.overtimeOut;
            if (!hasIn1 && !hasOut1 && !hasIn2 && !hasOut2 && !hasOtIn && !hasOtOut) return 'Absent';
            const morningComplete = hasIn1 && hasOut1;
            const afternoonComplete = hasIn2 && hasOut2;
            if ((hasIn1 !== hasOut1) || (hasIn2 !== hasOut2) || (hasOtIn && !hasOtOut) || (morningComplete !== afternoonComplete))
                return 'Half-day';
            const firstIn = minutesOf(draft.timeIn1);
            const late = firstIn !== null && firstIn > (8 * 60) + 30;
            const lastOut = minutesOf(draft.timeOut2) ?? (minutesOf(draft.timeOut1) !== null && minutesOf(draft.timeOut1) >= 13 * 60
                ? minutesOf(draft.timeOut1) : null);
            const early = lastOut !== null && lastOut < (17 * 60) - 15;
            if (late && early) return 'Late + Early Off';
            if (late) return 'Late';
            if (early) return 'Early Off';
            return 'Complete';
        }

        function overlayDraft() {
            return {
                timeIn1: fromHtmlTime(document.getElementById('reIn1').value),
                timeOut1: fromHtmlTime(document.getElementById('reOut1').value),
                timeIn2: fromHtmlTime(document.getElementById('reIn2').value),
                timeOut2: fromHtmlTime(document.getElementById('reOut2').value),
                overtimeIn: fromHtmlTime(document.getElementById('reOtIn').value),
                overtimeOut: fromHtmlTime(document.getElementById('reOtOut').value)
            };
        }

        function refreshRecordEditMeta() {
            const draft = overlayDraft();
            const status = draftStatus(draft);
            const pill = document.getElementById('reStatus');
            pill.textContent = status;
            pill.className = 'status-pill ' + (statusClass[status] || 'att-status-halfday');
            const hours = draftHours(draft);
            document.getElementById('reHours').textContent =
                hours.regular.toFixed(2) + ' regular hours · ' + hours.ot.toFixed(2) + ' overtime';
        }

        function openRecordEdit(row) {
            if (isAdmin || !row) return;
            if (row.pendingCorrection) {
                showToast('This attendance row already has a correction request waiting for admin review.');
                return;
            }
            editingRecord = row;
            document.getElementById('recordEditTitle').textContent = row.actionLabel || 'Request Edit';
            document.getElementById('reDisplayId').textContent = row.displayId || '——';
            document.getElementById('reName').textContent = row.employeeName || '——';
            document.getElementById('reDate').textContent = row.workDate || '——';
            document.getElementById('reIn1').value = toHtmlTime(row.timeIn1);
            document.getElementById('reOut1').value = toHtmlTime(row.timeOut1);
            document.getElementById('reIn2').value = toHtmlTime(row.timeIn2);
            document.getElementById('reOut2').value = toHtmlTime(row.timeOut2);
            document.getElementById('reOtIn').value = toHtmlTime(row.overtimeIn);
            document.getElementById('reOtOut').value = toHtmlTime(row.overtimeOut);
            const reasonWrap = document.getElementById('reReasonWrap');
            const reasonInput = document.getElementById('reReason');
            const saveBtn = document.getElementById('reSave');
            if (row.requestEdit) {
                reasonWrap.style.display = 'block';
                reasonInput.value = 'Half-day attendance';
                saveBtn.textContent = 'Submit Request';
            } else {
                reasonWrap.style.display = 'none';
                reasonInput.value = '';
                saveBtn.textContent = 'Save';
            }
            refreshRecordEditMeta();
            document.getElementById('recordEditOverlay').hidden = false;
        }

        function closeRecordEdit() {
            document.getElementById('recordEditOverlay').hidden = true;
            editingRecord = null;
        }

        if (!isAdmin) {
        document.getElementById('recordsBody').addEventListener('click', function (e) {
            const btn = e.target.closest('[data-record-id]');
            if (!btn) return;
            const row = lastRows.find(r => String(r.recordId) === String(btn.dataset.recordId));
            openRecordEdit(row);
        });

        document.getElementById('reCancel').addEventListener('click', closeRecordEdit);
        document.getElementById('recordEditOverlay').addEventListener('click', function (e) {
            if (e.target.id === 'recordEditOverlay') closeRecordEdit();
        });
        document.getElementById('reStandard').addEventListener('click', function () {
            document.getElementById('reIn1').value = '08:00';
            document.getElementById('reOut1').value = '12:00';
            document.getElementById('reIn2').value = '13:00';
            document.getElementById('reOut2').value = '17:00';
            refreshRecordEditMeta();
        });
        document.getElementById('reClear').addEventListener('click', function () {
            ['reIn1', 'reOut1', 'reIn2', 'reOut2', 'reOtIn', 'reOtOut'].forEach(id => {
                document.getElementById(id).value = '';
            });
            refreshRecordEditMeta();
        });
        ['reIn1', 'reOut1', 'reIn2', 'reOut2', 'reOtIn', 'reOtOut'].forEach(id => {
            document.getElementById(id).addEventListener('input', refreshRecordEditMeta);
        });
        document.getElementById('reSave').addEventListener('click', async function () {
            if (!editingRecord) return;
            const draft = overlayDraft();
            const requestEdit = !!editingRecord.requestEdit;
            if (requestEdit && !document.getElementById('reReason').value.trim()) {
                showToast('Enter a reason for this correction request.');
                return;
            }
            const body = new FormData();
            body.set('recordId', editingRecord.recordId);
            body.set('timeIn1', toHtmlTime(draft.timeIn1));
            body.set('timeOut1', toHtmlTime(draft.timeOut1));
            body.set('timeIn2', toHtmlTime(draft.timeIn2));
            body.set('timeOut2', toHtmlTime(draft.timeOut2));
            body.set('overtimeIn', toHtmlTime(draft.overtimeIn));
            body.set('overtimeOut', toHtmlTime(draft.overtimeOut));
            if (requestEdit) body.set('reason', document.getElementById('reReason').value.trim());
            if (token) body.set('__RequestVerificationToken', token);

            const url = requestEdit ? '/Attendance/RequestCorrection' : '/Attendance/UpdateRecord';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'RequestVerificationToken': token },
                body
            });
            const data = await res.json();
            if (!data.success) {
                showToast(data.message || 'Could not save the attendance row.');
                return;
            }
            closeRecordEdit();
            loadRecords();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !document.getElementById('recordEditOverlay').hidden) {
                closeRecordEdit();
            }
        });
        }
    </script>
}
