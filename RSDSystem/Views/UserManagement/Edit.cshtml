@model RSDSystem.Models.User
@{
    ViewData["Title"] = "Edit User";
    var isPayrollStaff = string.Equals(Model.Role, "PayrollStaff", StringComparison.OrdinalIgnoreCase);
    var initials = $"{(string.IsNullOrEmpty(Model.FirstName) ? "" : Model.FirstName[..1])}{(string.IsNullOrEmpty(Model.LastName) ? "" : Model.LastName[..1])}";
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<div class="content-topbar page-sticky-bar">
    <a asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="form-card">
    <partial name="_InviteLinkBox" />

    <div class="edit-layout">

        <div class="edit-photo-col">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" class="edit-photo-circle" />
            }
            else
            {
                <div class="edit-photo-initials">
                    @initials
                </div>
            }

            @if (isPayrollStaff)
            {
                @if (Model.IsActive)
                {
                    <button type="button" class="status-toggle-btn status-toggle-inactive"
                            onclick="confirmToggleUserStatus(@Model.UserId)">
                        <i class="bi bi-toggle-on"></i> Active
                    </button>
                }
                else
                {
                    <button type="button" class="status-toggle-btn status-toggle-active"
                            onclick="toggleUserStatus(@Model.UserId)">
                        <i class="bi bi-toggle-off"></i> Inactive
                    </button>
                }
            }
        </div>

        <div class="edit-fields-col">

            <div class="form-row form-row-3">
                <div>
                    <label class="form-lbl">First Name</label>
                    <input type="text" class="form-ctrl" value="@Model.FirstName" readonly />
                </div>
                <div>
                    <label class="form-lbl">Last Name</label>
                    <input type="text" class="form-ctrl" value="@Model.LastName" readonly />
                </div>
                <div>
                    <label class="form-lbl">M.I</label>
                    <input type="text" class="form-ctrl" value="@Dash(Model.MiddleInitial)" readonly />
                </div>
            </div>

            <div class="form-row form-row-3b">
                <div>
                    <label class="form-lbl">Date of Birth</label>
                    <input type="text" class="form-ctrl"
                           value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("MMMM d, yyyy") : "—")"
                           readonly />
                </div>
                <div>
                    <label class="form-lbl">Age</label>
                    <input type="text" class="form-ctrl" readonly value="@(Model.Age?.ToString() ?? "—")" />
                </div>
                <div>
                    <label class="form-lbl">Gender</label>
                    <input type="text" class="form-ctrl" value="@Dash(Model.Gender)" readonly />
                </div>
            </div>

            <div class="form-row form-row-1">
                <div>
                    <label class="form-lbl">Username</label>
                    <input type="text" class="form-ctrl" value="@Model.Username" readonly />
                </div>
            </div>

            <div class="form-hint-box">
                <i class="bi bi-info-circle-fill"></i>
                Passwords are private. Admin cannot view or change them.
            </div>

            <div class="form-row form-row-2">
                <div>
                    <label class="form-lbl">Email</label>
                    <input type="email" class="form-ctrl" value="@Model.Email" readonly />
                </div>
                <div>
                    <label class="form-lbl">Contact Number</label>
                    <input type="text" class="form-ctrl" value="@Model.ContactNumber" readonly />
                </div>
            </div>

            <div class="form-row form-row-1">
                <div>
                    <label class="form-lbl">Address</label>
                    <input type="text" class="form-ctrl" value="@Dash(Model.Address)" readonly />
                </div>
            </div>

            <div class="form-row form-row-2">
                <div>
                    <label class="form-lbl">Photo</label>
                    <input type="text" class="form-ctrl"
                           value="@(string.IsNullOrEmpty(Model.PhotoPath) ? "No file chosen" : System.IO.Path.GetFileName(Model.PhotoPath))"
                           readonly />
                </div>
                <div>
                    <label class="form-lbl">Role</label>
                    <input type="text" class="form-ctrl"
                           value="@(Model.Role == "PayrollStaff" ? "Payroll Staff" : Model.Role)" readonly />
                </div>
            </div>

            <form asp-action="SendInvite" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <button type="submit" class="btn-primary-blue-block">Send set-password email</button>
            </form>
        </div>
    </div>

    <form id="toggleStatusForm" method="post" style="display: none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<div class="del-overlay" id="deactivateUserOverlay" onclick="closeDeactivateUserModal(arguments[0])">
    <div class="del-modal">
        <div class="del-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill del-icon"></i>
        </div>
        <div class="del-title">Set as Inactive?</div>
        <div class="del-msg">
            <strong>@Model.FullName</strong> will not be able to log in until they are set Active again.
        </div>
        <div class="del-actions">
            <button type="button" class="del-btn-cancel" onclick="closeDeactivateUserModal()">Cancel</button>
            <button type="button" class="del-btn-delete" onclick="toggleUserStatus(@Model.UserId)">Set Inactive</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmToggleUserStatus(userId) {
            document.getElementById('deactivateUserOverlay').classList.add('open');
        }

        function closeDeactivateUserModal(e) {
            if (!e || e.target === document.getElementById('deactivateUserOverlay'))
                document.getElementById('deactivateUserOverlay').classList.remove('open');
        }

        function toggleUserStatus(userId) {
            const form = document.getElementById('toggleStatusForm');
            form.action = '/UserManagement/ToggleStatus/' + userId;
            form.submit();
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape')
                closeDeactivateUserModal();
        });
    </script>
}
