@model RSDSystem.Models.User
@{
    ViewData["Title"] = "Add User";
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var generalErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .ToList();
    var maxDob = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
    var minDob = DateTime.Today.AddYears(-80).ToString("yyyy-MM-dd");
}

<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<a asp-action="Index" class="btn-back">
    <i class="bi bi-arrow-left"></i> Back
</a>

<div class="form-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="js-validate" novalidate>
        @Html.AntiForgeryToken()
        @if (generalErrors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:13px">
                <ul class="mb-0 ps-3">
                    @foreach (var err in generalErrors)
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="form-row form-row-3">
            <div>
                <label class="form-lbl">First Name <span class="req-star">*</span></label>
                <input type="text" name="FirstName" value="@Model.FirstName" maxlength="80"
                       class="@Ctrl("FirstName")" data-validate="required|name" data-label="First name" />
                <span class="field-error" data-error-for="FirstName">@Err("FirstName")</span>
            </div>
            <div>
                <label class="form-lbl">Last Name <span class="req-star">*</span></label>
                <input type="text" name="LastName" value="@Model.LastName" maxlength="80"
                       class="@Ctrl("LastName")" data-validate="required|name" data-label="Last name" />
                <span class="field-error" data-error-for="LastName">@Err("LastName")</span>
            </div>
            <div>
                <label class="form-lbl">M.I</label>
                <input type="text" name="MiddleInitial" value="@Model.MiddleInitial" maxlength="2"
                       class="@Ctrl("MiddleInitial")" data-validate="mi" data-label="Middle initial" />
                <span class="field-error" data-error-for="MiddleInitial">@Err("MiddleInitial")</span>
            </div>
        </div>

        <div class="form-row form-row-3b">
            <div>
                <label class="form-lbl">Date of Birth</label>
                <input type="date" name="DateOfBirth" id="dobInput"
                       value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")"
                       min="@minDob" max="@maxDob"
                       class="@Ctrl("DateOfBirth")" data-validate="dob" data-label="Date of birth" />
                <span class="field-error" data-error-for="DateOfBirth">@Err("DateOfBirth")</span>
            </div>
            <div>
                <label class="form-lbl">Age</label>
                <input type="text" id="ageInput" class="form-ctrl" readonly placeholder="—" value="@Model.Age" />
            </div>
            <div>
                <label class="form-lbl">Gender</label>
                <select name="Gender" class="form-ctrl">
                    <option value="">Select</option>
                    <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                    <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                </select>
            </div>
        </div>

        <div class="form-row form-row-1">
            <div>
                <label class="form-lbl">Username <span class="req-star">*</span></label>
                <input type="text" name="Username" value="@Model.Username" maxlength="50"
                       class="@Ctrl("Username")" data-validate="required" data-label="Username" />
                <span class="field-error" data-error-for="Username">@Err("Username")</span>
            </div>
        </div>

        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Password <span class="req-star">*</span></label>
                <div class="pwd-wrap">
                    <input type="password" name="Password" id="pwd" class="@Ctrl("Password")"
                           data-validate="required|minlen8" data-label="Password" />
                    <span class="pwd-eye" onclick="togglePwd('pwd','eye1')">
                        <i class="bi bi-eye-slash" id="eye1"></i>
                    </span>
                </div>
                <span class="field-error" data-error-for="Password">@Err("Password")</span>
            </div>
            <div>
                <label class="form-lbl">Confirm Password <span class="req-star">*</span></label>
                <div class="pwd-wrap">
                    <input type="password" name="ConfirmPassword" id="cpwd" class="@Ctrl("ConfirmPassword")"
                           data-validate="required|match" data-match="pwd" data-label="Confirm password" />
                    <span class="pwd-eye" onclick="togglePwd('cpwd','eye2')">
                        <i class="bi bi-eye-slash" id="eye2"></i>
                    </span>
                </div>
                <span class="field-error" data-error-for="ConfirmPassword">@Err("ConfirmPassword")</span>
            </div>
        </div>

        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Email <span class="req-star">*</span></label>
                <input type="email" name="Email" value="@Model.Email" maxlength="100"
                       class="@Ctrl("Email")" data-validate="required|email" data-label="Email" />
                <span class="field-error" data-error-for="Email">@Err("Email")</span>
            </div>
            <div>
                <label class="form-lbl">Contact Number <span class="req-star">*</span></label>
                <input type="text" name="ContactNumber" value="@Model.ContactNumber" maxlength="11"
                       inputmode="numeric" class="@Ctrl("ContactNumber")"
                       data-validate="required|phone" data-label="Contact number"
                       placeholder="09XXXXXXXXX" />
                <span class="field-error" data-error-for="ContactNumber">@Err("ContactNumber")</span>
            </div>
        </div>

        <div class="form-row form-row-1">
            <div>
                <label class="form-lbl">Address</label>
                <input type="text" name="Address" value="@Model.Address" maxlength="250"
                       class="@Ctrl("Address")" data-validate="address" data-label="Address"
                       placeholder="Barangay, Municipality/City, Province" />
                <span class="field-error" data-error-for="Address">@Err("Address")</span>
            </div>
        </div>

        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Photo</label>
                <div class="file-row">
                    <label class="file-choose-btn" for="photoInput">Choose File</label>
                    <span class="file-name-lbl" id="fileLabel">No File Chosen</span>
                </div>
                <input type="file" id="photoInput" name="photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       class="d-none" data-validate="fileImage"
                       onchange="document.getElementById('fileLabel').textContent =
                           this.files.length ? this.files[0].name : 'No File Chosen'" />
                <span class="field-error" data-error-for="photo">@Err("photo")</span>
            </div>
            <div>
                <label class="form-lbl">Role</label>
                <input type="text" class="form-ctrl" value="Payroll Staff" readonly />
                <input type="hidden" name="Role" value="PayrollStaff" />
            </div>
        </div>

        <button type="submit" class="btn-primary-blue-block">Add User</button>
    </form>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script>
        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (!input || !icon) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'text' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
}
