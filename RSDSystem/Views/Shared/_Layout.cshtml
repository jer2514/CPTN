<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>RSD Payroll System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link href="~/css/site.css?v=79" rel="stylesheet" asp-append-version="true" />
</head>

<body data-role="@(Context.Session.GetString("Role") ?? "")">

    <div class="app-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="logo-container">
                <img src="~/Uploads/Images/RSDLogo.png" alt="Logo">
            </div>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                var isPayrollSection = currentController == "Payroll" || currentController == "CashAdvance";
                var isPayrollPrediction = currentController == "Payroll" && currentAction == "Prediction";
                var isPayrollCashAdvance = currentController == "CashAdvance";
            }
            <ul class="menu">
                <li class="@(currentController == "Home" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                </li>

                <li class="@(currentController == "UserManagement" ? "active" : "")">
                    <a asp-controller="UserManagement" asp-action="Index">
                        <i class="bi bi-people-fill"></i> User Management
                    </a>
                </li>

                <li class="@(currentController == "Employee" ? "active" : "")">
                    <a asp-controller="Employee" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Employees
                    </a>
                </li>

                <li>
                    <a href="#adminPayrollMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(isPayrollSection ? "active" : "")"
                       role="button" aria-expanded="@(isPayrollSection ? "true" : "false")">
                        <i class="bi bi-cash-coin"></i> Payroll
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(isPayrollSection ? "show" : "")" id="adminPayrollMenu">
                        <li class="@(!isPayrollPrediction && !isPayrollCashAdvance && isPayrollSection ? "active" : "")">
                            <a asp-controller="Payroll" asp-action="Index">View Payroll</a>
                        </li>
                        <li class="@(isPayrollCashAdvance ? "active" : "")">
                            <a asp-controller="CashAdvance" asp-action="Index">Cash Advance</a>
                        </li>
                        <li class="@(isPayrollPrediction ? "active" : "")">
                            <a asp-controller="Payroll" asp-action="Prediction">Payroll Prediction</a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="#adminAttendanceMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(currentController == "Attendance" ? "active" : "")"
                       role="button" aria-expanded="@(currentController == "Attendance" ? "true" : "false")">
                        <i class="bi bi-clock-history"></i> Attendance
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(currentController == "Attendance" ? "show" : "")" id="adminAttendanceMenu">
                        <li class="@(currentAction == "Records" || currentAction == "Edit" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Records">Attendance Records</a>
                        </li>
                        <li class="@(currentAction == "Summary" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Summary">Attendance Summary</a>
                        </li>
                    </ul>
                </li>

                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Project" ? "active" : "")">
                    <a asp-controller="Project" asp-action="Index">
                        <i class="bi bi-kanban-fill"></i> Projects
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")">
                    <a asp-controller="Report" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i> Reports
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ActivityLog" ? "active" : "")">
                    <a asp-controller="ActivityLog" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Activity Logs
                    </a>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Sign out
                    </a>
                </li>
            </ul>

            @await Html.PartialAsync("_ProfileCard")

        </aside>

        <!-- CONTENT -->
        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <!-- Toast container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center rsd-toast rsd-toast-success" role="alert"
                 aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center rsd-toast rsd-toast-error" role="alert"
                 aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <form id="__notifToken" style="display:none">@Html.AntiForgeryToken()</form>

    <div class="del-overlay" id="attendanceCorrectionOverlay">
        <div class="corr-modal">
            <div class="corr-title">Attendance Correction Request</div>
            <div class="corr-meta">
                <div><strong>Payroll Staff:</strong> <span id="corrStaff">—</span></div>
                <div><strong>Project:</strong> <span id="corrProject">—</span></div>
            </div>
            <table class="corr-table">
                <thead>
                    <tr>
                        <th>Employee Name</th>
                        <th>Date</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>OT In</th>
                        <th>OT Out</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="corrName">—</td>
                        <td id="corrDate">—</td>
                        <td id="corrIn1">—</td>
                        <td id="corrOut1">—</td>
                        <td id="corrIn2">—</td>
                        <td id="corrOut2">—</td>
                        <td id="corrOtIn">—</td>
                        <td id="corrOtOut">—</td>
                    </tr>
                </tbody>
            </table>
            <div class="corr-reason"><strong>Reason:</strong> <span id="corrReason">—</span></div>
            <div class="corr-actions" id="corrActions">
                <button type="button" class="btn-approve" id="corrApprove">Approve</button>
                <button type="button" class="btn-return" id="corrReturn">Return for Correction</button>
            </div>
            <div class="corr-return-wrap" id="corrReturnWrap" hidden>
                <label class="form-lbl" for="corrReturnReason">Reason for returning this correction</label>
                <textarea id="corrReturnReason" class="form-ctrl" rows="3" maxlength="250"
                          placeholder="The submitted correction could not be verified."></textarea>
                <div class="corr-actions">
                    <button type="button" class="btn-outline-blue" id="corrReturnCancel">Cancel</button>
                    <button type="button" class="btn-return" id="corrReturnSend">Return Request</button>
                </div>
            </div>
        </div>
    </div>

    <div class="del-overlay" id="taskApprovalOverlay">
        <div class="corr-modal task-approval-modal">
            <div class="corr-title">Task Approval</div>
            <div class="corr-meta">
                <div><strong>Payroll Staff:</strong> <span id="taskStaff">—</span></div>
                <div><strong>Project:</strong> <span id="taskProject">—</span></div>
                <div><strong>Type of Project:</strong> <span id="taskType">—</span></div>
                <div><strong>Period:</strong> <span id="taskPeriod">—</span></div>
            </div>
            <div class="corr-reason">Staff marked this payroll task as done. Approve to close it, or return it for correction so it stays on To do task.</div>
            <div class="corr-actions" id="taskActions">
                <button type="button" class="btn-approve" id="taskApprove">Approve</button>
                <button type="button" class="btn-return" id="taskReturn">Return for Correction</button>
            </div>
            <div class="corr-return-wrap" id="taskReturnWrap" hidden>
                <label class="form-lbl" for="taskReturnReason">Reason for returning this task</label>
                <textarea id="taskReturnReason" class="form-ctrl" rows="3" maxlength="250"
                          placeholder="Please correct this payroll task and mark it done again."></textarea>
                <div class="corr-actions">
                    <button type="button" class="btn-outline-blue" id="taskReturnCancel">Cancel</button>
                    <button type="button" class="btn-return" id="taskReturnSend">Return Task</button>
                </div>
            </div>
        </div>
    </div>

    <div class="ca-overlay" id="cashAdvanceNotifOverlay" hidden>
        <div class="ca-panel">
            <div class="ca-panel-title">Cash Advance</div>
            <p class="ca-success-msg" id="caNotifMessage"></p>
            <div class="att-table-wrap" style="margin-top:14px">
                <table class="emp-table att-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Job</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody id="caNotifRows">
                        <tr><td colspan="3" class="text-center text-muted py-3">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="ca-panel-actions">
                <button type="button" class="ca-btn-cancel" id="caNotifCloseBtn">Close</button>
                <a class="btn-primary-blue" id="caNotifOpenBtn" href="#">Open Payroll</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.toast').forEach(el => {
            new bootstrap.Toast(el).show();
        });
    </script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
