<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RSD Payroll System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css?v=25" rel="stylesheet" asp-append-version="true" />
</head>
<body>

    @{
        var fullName = Context.Session.GetString("FullName") ?? "Guest";
        var role = Context.Session.GetString("Role");
        var photo = Context.Session.GetString("PhotoPath");
        var displayRole = role == "PayrollStaff" ? "Payroll Staff" : (role ?? "Not logged in");
        var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpper(w[0])));

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isPayrollSection = currentAction == "GeneratePayroll" || currentAction == "PendingPayroll"
            || currentAction == "PayrollSlip" || currentAction == "ViewPayroll";
        var isAttendanceSection = currentController == "Attendance";
    }

    <div class="app-layout">

        <aside class="sidebar">
            <div class="logo-container">
                <img src="~/Uploads/Images/RSDLogo.png" alt="Logo">
            </div>

            <ul class="menu">
                <li class="@(currentAction == "Index" ? "active" : "")">
                    <a asp-controller="PayrollStaff" asp-action="Index">
                        <i class="bi bi-clipboard2-check-fill"></i> Task
                    </a>
                </li>

                <li>
                    <a href="#staffPayrollMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(isPayrollSection ? "active" : "")"
                       role="button" aria-expanded="@(isPayrollSection ? "true" : "false")">
                        <i class="bi bi-cash-coin"></i> Payroll
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(isPayrollSection ? "show" : "")" id="staffPayrollMenu">
                        <li class="@(currentAction == "GeneratePayroll" ? "active" : "")">
                            <a asp-controller="PayrollStaff" asp-action="GeneratePayroll">Generate Payroll</a>
                        </li>
                        <li class="@(currentAction == "PendingPayroll" ? "active" : "")">
                            <a asp-controller="PayrollStaff" asp-action="PendingPayroll">Pending Payroll</a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="#staffAttendanceMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(isAttendanceSection ? "active" : "")"
                       role="button" aria-expanded="@(isAttendanceSection ? "true" : "false")">
                        <i class="bi bi-calendar2-check-fill"></i> Attendance
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(isAttendanceSection ? "show" : "")" id="staffAttendanceMenu">
                        <li class="@(currentAction == "Import" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Import">Import Attendance</a>
                        </li>
                        <li class="@(currentAction == "Records" || currentAction == "Edit" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Records">Attendance Records</a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </li>
            </ul>



            <div class="profile-card">
                @if (!string.IsNullOrEmpty(photo))
                {
                    <img src="@photo" alt="User">
                }
                else
                {
                    <span class="profile-avatar-initials">@initials</span>
                }

                <div>
                    <div class="user-name">@fullName</div>
                    <div class="user-role">@displayRole</div>
                </div>
            </div>
        </aside>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>