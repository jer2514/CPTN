<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RSD Payroll System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="app-layout">

        <aside class="sidebar">
            <div class="logo-container">
                <img src="~/Uploads/Images/RSDLogo.png" alt="Logo">
            </div>

            <ul class="menu">
                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PayrollStaff" ? "active" : "")">
                    <a asp-controller="PayrollStaff" asp-action="Index">
                        <i class="bi bi-clipboard2-check-fill"></i> Task
                    </a>
                </li>

                <li>
                    <a href="#staffPayrollMenu" data-bs-toggle="collapse" class="menu-dropdown-toggle" role="button" aria-expanded="false">
                        <i class="bi bi-cash-coin"></i> Payroll
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu" id="staffPayrollMenu">
                        <li><a href="#">My Payslip</a></li>
                        <li><a href="#">Process Payroll</a></li>
                    </ul>
                </li>

                <li>
                    <a href="#staffAttendanceMenu" data-bs-toggle="collapse" class="menu-dropdown-toggle" role="button" aria-expanded="false">
                        <i class="bi bi-calendar2-check-fill"></i> Attendance
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu" id="staffAttendanceMenu">
                        <li><a href="#">Mark Attendance</a></li>
                        <li><a href="#">Attendance Records</a></li>
                    </ul>
                </li>
            </ul>

            <div class="menu-logout">
                <a asp-controller="Home" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>

            <div class="profile-card">
                <img src="~/images/user.jpg" alt="User">
                <div>
                    <div class="user-name">Patrick Bateman</div>
                    <div class="user-role">Payroll Staff</div>
                </div>
            </div>
        </aside>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>