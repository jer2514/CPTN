<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RSD Payroll System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css?v=64" rel="stylesheet" asp-append-version="true" />
</head>
<body data-role="@(Context.Session.GetString("Role") ?? "")">

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isPayrollSection = currentAction == "GeneratePayroll" || currentAction == "PendingPayroll"
            || currentAction == "PayrollSlip" || currentAction == "ViewPayroll";
        var isAttendanceSection = currentController == "Attendance";
    }

    <div class="app-layout">

        <aside class="sidebar">
            <div class="logo-container">
                <img src="~/Uploads/Images/RSDLogo.png" alt="Logo">
            </div>

            <ul class="menu">
                <li class="@(currentAction == "Index" ? "active" : "")">
                    <a asp-controller="PayrollStaff" asp-action="Index">
                        <i class="bi bi-clipboard2-check-fill"></i> Task
                    </a>
                </li>

                <li>
                    <a href="#staffPayrollMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(isPayrollSection ? "active" : "")"
                       role="button" aria-expanded="@(isPayrollSection ? "true" : "false")">
                        <i class="bi bi-cash-coin"></i> Payroll
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(isPayrollSection ? "show" : "")" id="staffPayrollMenu">
                        <li class="@(currentAction == "GeneratePayroll" ? "active" : "")">
                            <a asp-controller="PayrollStaff" asp-action="GeneratePayroll">Generate Payroll</a>
                        </li>
                        <li class="@(currentAction == "PendingPayroll" ? "active" : "")">
                            <a asp-controller="PayrollStaff" asp-action="PendingPayroll">Pending Payroll</a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="#staffAttendanceMenu" data-bs-toggle="collapse"
                       class="menu-dropdown-toggle @(isAttendanceSection ? "active" : "")"
                       role="button" aria-expanded="@(isAttendanceSection ? "true" : "false")">
                        <i class="bi bi-calendar2-check-fill"></i> Attendance
                        <i class="bi bi-chevron-down menu-chevron"></i>
                    </a>
                    <ul class="collapse submenu @(isAttendanceSection ? "show" : "")" id="staffAttendanceMenu">
                        <li class="@(currentAction == "Import" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Import">Import Attendance</a>
                        </li>
                        <li class="@(currentAction == "Records" || currentAction == "Edit" ? "active" : "")">
                            <a asp-controller="Attendance" asp-action="Records">Attendance Records</a>
                        </li>
                    </ul>
                </li>
            </ul>

            @await Html.PartialAsync("_ProfileCard")
        </aside>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center rsd-toast rsd-toast-success" role="alert"
                 aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center rsd-toast rsd-toast-error" role="alert"
                 aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <form id="__notifToken" style="display:none">@Html.AntiForgeryToken()</form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.toast').forEach(el => {
            new bootstrap.Toast(el).show();
        });
    </script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>