@{
    var fullName = Context.Session.GetString("FullName") ?? "Guest";
    var role = Context.Session.GetString("Role");
    var photo = Context.Session.GetString("PhotoPath");
    var displayRole = role == "PayrollStaff" ? "Payroll Staff" : (role ?? "Not logged in");
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                             .Take(2)
                                             .Select(w => char.ToUpper(w[0])));
}

<div class="profile-wrap">
    <button type="button" class="profile-card" id="profileToggle"
            aria-expanded="false" aria-controls="profileMenu" title="Account">
        @if (!string.IsNullOrEmpty(photo))
        {
            <img src="@photo" alt="" />
        }
        else
        {
            <span class="profile-avatar-initials">@initials</span>
        }
        <div class="profile-card-text">
            <div class="user-name">@fullName</div>
            <div class="user-role">@displayRole</div>
        </div>
        <i class="bi bi-chevron-up profile-card-chevron"></i>
    </button>
    <div class="profile-menu" id="profileMenu" hidden>
        <a asp-controller="Account" asp-action="ChangePassword" class="profile-menu-item">
            <i class="bi bi-key-fill"></i> Change Password
        </a>
        <a asp-controller="Account" asp-action="Logout" class="profile-menu-item profile-menu-item-danger">
            <i class="bi bi-box-arrow-right"></i> Sign out
        </a>
    </div>
</div>
