@{
    var fullName = Context.Session.GetString("FullName") ?? "Guest";
    var role = Context.Session.GetString("Role");
    var photo = Context.Session.GetString("PhotoPath");
    var displayRole = role == "PayrollStaff" ? "Payroll Staff" : (role ?? "Not logged in");
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                             .Take(2)
                                             .Select(w => char.ToUpper(w[0])));
    var onProfile = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Profile", StringComparison.OrdinalIgnoreCase);
}

<div class="profile-wrap">
    <a asp-controller="Account" asp-action="Profile"
       class="profile-card @(onProfile ? "active" : "")"
       title="View profile">
        @if (!string.IsNullOrEmpty(photo))
        {
            <img src="@photo" alt="" />
        }
        else
        {
            <span class="profile-avatar-initials">@initials</span>
        }
        <div class="profile-card-text">
            <div class="user-name">@fullName</div>
            <div class="user-role">@displayRole</div>
        </div>
        <i class="bi bi-chevron-right profile-card-chevron"></i>
    </a>
</div>
