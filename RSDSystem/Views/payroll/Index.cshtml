@model List<RSDSystem.Models.PayrollPeriodRow>
@{
    ViewData["Title"] = "View Payroll";
    var projectName = ViewBag.ProjectName as string ?? "";
    int? selectedMonth = ViewBag.Month is int monthVal ? monthVal : (int?)null;
    var months = ViewBag.Months as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card">
    <div class="emp-title mb-3">View Payroll</div>

    <form asp-action="Index" method="get" class="vp-filters">
        <div>
            <label class="form-lbl">Project Name</label>
            @{
                ViewBag.SuggestProjectName = projectName;
            }
            <partial name="_ProjectNameSuggest" />
        </div>
        <div>
            <label class="form-lbl">Payroll Month</label>
            <select name="month" class="form-ctrl" onchange="this.form.submit()">
                <option value="">All months</option>
                @foreach (var month in months)
                {
                    if (selectedMonth == month.Key)
                    {
                        <option value="@month.Key" selected>@month.Value</option>
                    }
                    else
                    {
                        <option value="@month.Key">@month.Value</option>
                    }
                }
            </select>
        </div>
        <div class="vp-filter-submit">
            <button type="submit" class="btn-primary-blue-solid">Apply</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">No approved payrolls found.</div>
    }
    else
    {
        <div class="vp-period-list">
            @foreach (var row in Model)
            {
                <div class="vp-period-card">
                    <div class="vp-period-head">
                        <span>Start Date</span>
                        <span>End Date</span>
                        <span>Payroll Staff</span>
                        <span>Action</span>
                    </div>
                    <div class="vp-period-body">
                        <span>@row.StartDate.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span>@row.EndDate.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span>@row.PayrollStaff</span>
                        <span>
                            <a class="pill-btn pill-view"
                               asp-action="Period"
                               asp-route-projectId="@row.ProjectId"
                               asp-route-start="@row.StartDate.ToString("yyyy-MM-dd")"
                               asp-route-end="@row.EndDate.ToString("yyyy-MM-dd")">
                                <i class="bi bi-eye-fill"></i> View
                            </a>
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/project-suggest.js" asp-append-version="true"></script>
}
