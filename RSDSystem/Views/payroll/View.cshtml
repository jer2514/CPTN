@model RSDSystem.Models.Payroll
@using RSDSystem.Helpers
@{
    ViewData["Title"] = "View Payroll";
}


<div class="content-topbar">
    <div class="page-label">View Payroll (Admin)</div>
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<a asp-action="Period"
   asp-route-projectId="@Model.ProjectId"
   asp-route-start="@Model.PayPeriodStart.ToString("yyyy-MM-dd")"
   asp-route-end="@Model.PayPeriodEnd.ToString("yyyy-MM-dd")"
   class="btn-back">
    <i class="bi bi-arrow-left"></i> Back
</a>

<div class="payslip-card">
    <div class="payslip-title">RSD Construction Services</div>
    <div class="payslip-subtitle">Employee Payslip</div>

    <div class="payslip-section-lbl">Employee Information</div>
    <div class="payslip-row2">
        <div><span class="payslip-lbl">Employee ID: </span><span class="payslip-val">@ViewBag.DisplayId</span></div>
        <div><span class="payslip-lbl">Project Assigned: </span><span class="payslip-val">@(Model.Project?.ProjectName ?? "—")</span></div>
    </div>
    <div class="payslip-row2">
        <div><span class="payslip-lbl">Employee Name: </span><span class="payslip-val">@Model.Employee?.FullName</span></div>
        <div><span class="payslip-lbl">Rate per day: </span><span class="payslip-val">₱@Model.Employee?.DailyRate.ToString("N2")</span></div>
    </div>
    <div class="payslip-row2">
        <div><span class="payslip-lbl">Job Classification: </span><span class="payslip-val">@Model.Employee?.JobClassification</span></div>
        <div><span class="payslip-lbl">Rate per hour: </span><span class="payslip-val">₱@Model.Employee?.RatePerHour.ToString("N2")</span></div>
    </div>

    <div class="payslip-section-lbl">
        Attendance Summary
        <span class="payslip-period">Payroll Period: @Model.PayPeriodStart.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture) - @Model.PayPeriodEnd.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
    </div>
    <div class="payslip-line"><span>Regular Days Worked:</span><span class="payslip-val">@Model.RegularDaysWorked Days</span></div>
    <div class="payslip-line"><span>Overtime:</span><span class="payslip-val">@Model.OvertimeHours hours</span></div>
    <div class="payslip-line"><span>Absent:</span><span class="payslip-val">@Model.AbsentDays Days</span></div>

    <div class="payslip-section-lbl">Payroll Computation</div>
    <div class="payslip-line"><span>Regular Pay:</span><span class="payslip-val">₱@Model.RegularPay.ToString("N2")</span></div>
    <div class="payslip-line"><span>Overtime Pay:</span><span class="payslip-val">₱@Model.OvertimePay.ToString("N2")</span></div>
    <div class="payslip-line payslip-line-strong"><span>Gross Pay:</span><span class="payslip-val">₱@Model.GrossPay.ToString("N2")</span></div>
    <div class="payslip-line"><span>Cash Advance:</span><span class="payslip-val">₱@Model.CashAdvance.ToString("N2")</span></div>
    <div class="payslip-line payslip-line-strong"><span>Net Pay:</span><span class="payslip-val">₱@Model.NetPay.ToString("N2")</span></div>

    <div class="payslip-footer">Generated Date: @Model.GeneratedDate.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>

    @if (Model.Status == RSDSystem.Models.PayrollStatusOptions.Correction && !string.IsNullOrWhiteSpace(Model.CorrectionReason))
    {
        <div class="correction-banner">
            <div class="correction-banner-title">
                <i class="bi bi-exclamation-triangle-fill"></i> Reason for Correction
            </div>
            <div class="correction-banner-text">@Model.CorrectionReason</div>
        </div>
    }

    @if (Model.Status == RSDSystem.Models.PayrollStatusOptions.Submitted)
    {
        <div class="payslip-approve-row">
            <button type="button" class="btn-approve" onclick="approvePayroll()">Approve</button>
            <button type="button" class="btn-return" onclick="openCorrectionModal()">Return for Correction</button>
        </div>
    }
    else
    {
        <div class="payslip-approve-row">
            <span class="status-pill status-@Model.Status.ToLower()">@Model.Status</span>
        </div>
    }
</div>

<!-- Reason for Correction Modal -->
<div class="del-overlay" id="correctionOverlay">
    <div class="del-modal correction-modal">
        <div class="del-title">Reason for Correction</div>
        <textarea id="correctionReasonInput" class="form-ctrl correction-textarea"
                  placeholder="Enter the reason for correction..."></textarea>
        <div class="del-actions">
            <button class="del-btn-cancel" onclick="closeCorrectionModal()">Cancel</button>
            <button class="del-btn-delete" style="background:#E1962B" onclick="submitCorrection()">Return Payroll</button>
        </div>
    </div>
</div>

<!-- Result Confirmation Modal -->
<div class="del-overlay" id="actionResultOverlay">
    <div class="del-modal">
        <div class="del-icon-wrap" style="background:#d4f7e0">
            <i class="bi bi-check-circle-fill" style="color:#0d7a3e;font-size:28px"></i>
        </div>
        <div class="del-title">Done</div>
        <div class="del-msg" id="actionResultMsg"></div>
        <div class="del-actions">
            <button class="del-btn-delete" style="background:#266DF1"
                    onclick="window.location.href='@Url.Action("Index", "Payroll")'">
                OK
            </button>
        </div>
    </div>
</div>

<form id="__afToken" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        const payrollId = @Model.PayrollId;
        const token = document.querySelector('#__afToken input[name="__RequestVerificationToken"]').value;

        async function approvePayroll() {
            const form = new FormData();
            form.append('id', payrollId);
            form.append('__RequestVerificationToken', token);

            const res  = await fetch('/Payroll/Approve/' + payrollId, { method: 'POST', body: form });
            const data = await res.json();
            showResult(data);
        }

        function openCorrectionModal() {
            document.getElementById('correctionOverlay').classList.add('open');
        }
        function closeCorrectionModal() {
            document.getElementById('correctionOverlay').classList.remove('open');
        }

        async function submitCorrection() {
            const reason = document.getElementById('correctionReasonInput').value.trim();
            if (!reason) { alert('Please enter a reason for correction.'); return; }

            const form = new FormData();
            form.append('id', payrollId);
            form.append('reason', reason);
            form.append('__RequestVerificationToken', token);

            const res  = await fetch('/Payroll/ReturnForCorrection/' + payrollId, { method: 'POST', body: form });
            const data = await res.json();
            closeCorrectionModal();
            showResult(data);
        }

        function showResult(data) {
            if (!data.success) { alert(data.message || 'Something went wrong.'); return; }
            document.getElementById('actionResultMsg').textContent = data.message;
            document.getElementById('actionResultOverlay').classList.add('open');
        }
    </script>
}