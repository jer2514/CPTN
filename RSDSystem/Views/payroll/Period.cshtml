@model List<RSDSystem.Models.PayrollPeriodEmployeeRow>
@{
    ViewData["Title"] = "View Payroll";
    var projectId = (int)ViewBag.ProjectId;
    var projectName = ViewBag.ProjectName as string ?? "Project";
    var start = (DateTime)ViewBag.Start;
    var end = (DateTime)ViewBag.End;
    var startLabel = ViewBag.StartLabel as string ?? "";
    var endLabel = ViewBag.EndLabel as string ?? "";
}

<div class="content-topbar">
    <div class="page-label">View Payroll (Admin)</div>
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card">
    <div class="vp-detail-top">
        <a asp-action="Index" class="btn-back vp-inline-back">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="vp-detail-title">@projectName</div>
    <div class="vp-detail-dates">Date: @startLabel - @endLabel</div>

    <table class="emp-table vp-employee-table">
        <thead>
            <tr>
                <th>Employee Name</th>
                <th>Job</th>
                <th>Regular Hours</th>
                <th>OT Hours</th>
                <th>Net Pay</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No approved payrolls for this period.</td>
                </tr>
            }
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.EmployeeName</td>
                    <td>@row.Job</td>
                    <td>@row.RegularHours.ToString("0.##")</td>
                    <td>@row.OtHours.ToString("0.##")</td>
                    <td>₱@row.NetPay.ToString("N2")</td>
                    <td>
                        <span class="badge-active">Approved</span>
                    </td>
                    <td>
                        @if (row.PayrollId.HasValue)
                        {
                            <a class="pill-btn pill-view" asp-action="View" asp-route-id="@row.PayrollId">
                                <i class="bi bi-eye-fill"></i> View
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
