@model RSDSystem.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
    var jobs = ViewBag.JobClassifications as string[] ?? Array.Empty<string>();
    var projects = ViewBag.Projects as List<RSDSystem.Models.Project> ?? new();
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var generalErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .ToList();
    var maxDob = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
    var minDob = DateTime.Today.AddYears(-80).ToString("yyyy-MM-dd");
    var initials = $"{(string.IsNullOrEmpty(Model.FirstName) ? "" : Model.FirstName[..1])}{(string.IsNullOrEmpty(Model.LastName) ? "" : Model.LastName[..1])}";
    var assignedProjectName = Model.Project?.ProjectName;
}


<div class="content-topbar page-sticky-bar">
    <a asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="js-validate" novalidate>
        @Html.AntiForgeryToken()
        @if (generalErrors.Count > 0)
        {
            <div class="form-error-box">
                @foreach (var err in generalErrors)
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }
        <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />

        <!-- Main layout: photo left + fields right -->
        <div class="edit-layout">

            <!-- LEFT: Photo circle -->
            <div class="edit-photo-col">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" class="edit-photo-circle" id="photoPreview" />
                }
                else
                {
                    <div class="edit-photo-initials" id="photoPreviewPlaceholder">
                        @initials
                    </div>
                }
                <input type="file" id="photoInput" name="photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       class="d-none" data-validate="fileImage" onchange="previewPhoto(this)" />

                @if (Model.IsActive)
                {
                    <button type="button" class="status-toggle-btn status-toggle-inactive"
                            onclick="confirmToggleStatus(@Model.EmployeeId)">
                        <i class="bi bi-toggle-on"></i> Active
                    </button>
                }
                else
                {
                    <button type="button" class="status-toggle-btn status-toggle-active"
                            onclick="toggleEmployeeStatus(@Model.EmployeeId)">
                        <i class="bi bi-toggle-off"></i> Inactive
                    </button>
                }
            </div>

            <!-- RIGHT: All form fields -->
            <div class="edit-fields-col">

                <!-- First Name | Last Name | M.I. -->
                <div class="form-row form-row-3">
                    <div>
                        <label class="form-lbl">First Name <span class="req-star">*</span></label>
                        <input type="text" name="FirstName" value="@Model.FirstName" maxlength="80"
                               class="@Ctrl("FirstName")" data-validate="required|name" data-label="First name" />
                        <span class="field-error" data-error-for="FirstName">@Err("FirstName")</span>
                    </div>
                    <div>
                        <label class="form-lbl">Last Name <span class="req-star">*</span></label>
                        <input type="text" name="LastName" value="@Model.LastName" maxlength="80"
                               class="@Ctrl("LastName")" data-validate="required|name" data-label="Last name" />
                        <span class="field-error" data-error-for="LastName">@Err("LastName")</span>
                    </div>
                    <div>
                        <label class="form-lbl">M.I</label>
                        <input type="text" name="MiddleInitial" value="@Model.MiddleInitial" maxlength="2"
                               class="@Ctrl("MiddleInitial")" data-validate="mi" data-label="Middle initial" />
                        <span class="field-error" data-error-for="MiddleInitial">@Err("MiddleInitial")</span>
                    </div>
                </div>

                <!-- Date of Birth | Age | Gender -->
                <div class="form-row form-row-3b">
                    <div>
                        <label class="form-lbl">Date of Birth <span class="req-star">*</span></label>
                        <input type="date" name="DateOfBirth" id="dobInput"
                               value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")"
                               min="@minDob" max="@maxDob"
                               class="@Ctrl("DateOfBirth")" data-validate="required|dob" data-label="Date of birth" />
                        <span class="field-error" data-error-for="DateOfBirth">@Err("DateOfBirth")</span>
                    </div>
                    <div>
                        <label class="form-lbl">Age</label>
                        <input type="text" id="ageInput" class="form-ctrl"
                               readonly value="@Model.Age" placeholder="—" />
                    </div>
                    <div>
                        <label class="form-lbl">Gender <span class="req-star">*</span></label>
                        <select name="Gender" class="@Ctrl("Gender")" data-validate="required" data-label="Gender">
                            <option value="">Select</option>
                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                        </select>
                        <span class="field-error" data-error-for="Gender">@Err("Gender")</span>
                    </div>
                </div>

                <!-- Address -->
                <div class="form-row form-row-1">
                    <div>
                        <label class="form-lbl">Address <span class="req-star">*</span></label>
                        <input type="text" name="Address" value="@Model.Address" maxlength="250"
                               class="@Ctrl("Address")" data-validate="required|address" data-label="Address"
                               placeholder="Barangay, Municipality/City, Province" />
                        <span class="field-error" data-error-for="Address">@Err("Address")</span>
                    </div>
                </div>

                <!-- Email | Contact Number -->
                <div class="form-row form-row-2">
                    <div>
                        <label class="form-lbl">Email</label>
                        <input type="email" name="Email" value="@Model.Email" maxlength="100"
                               class="@Ctrl("Email")" data-validate="email" data-label="Email" />
                        <span class="field-error" data-error-for="Email">@Err("Email")</span>
                    </div>
                    <div>
                        <label class="form-lbl">Contact Number <span class="req-star">*</span></label>
                        <input type="text" name="ContactNumber" value="@Model.ContactNumber" maxlength="11"
                               inputmode="numeric" class="@Ctrl("ContactNumber")"
                               data-validate="required|phone" data-label="Contact number"
                               placeholder="09XXXXXXXXX" />
                        <span class="field-error" data-error-for="ContactNumber">@Err("ContactNumber")</span>
                    </div>
                </div>

                <!-- Assigned to Project -->
                <div class="form-row form-row-1">
                    <div>
                        <label class="form-lbl">Assigned to Project</label>
                        <select name="ProjectId" id="projectSelect" class="form-ctrl">
                            <option value="">Select project</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.ProjectId" selected="@(p.ProjectId == Model.ProjectId)">@p.ProjectName</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Job Classification | Rate per Day | Rate per Hour -->
                <div class="form-row form-row-eq3">
                    <div>
                        <label class="form-lbl">Job Classification <span class="req-star">*</span></label>
                        <select name="JobClassification" class="@Ctrl("JobClassification")"
                                data-validate="required" data-label="Job classification">
                            <option value="">Select</option>
                            @foreach (var j in jobs)
                            {
                                <option value="@j" selected="@(j == Model.JobClassification)">@j</option>
                            }
                        </select>
                        <span class="field-error" data-error-for="JobClassification">@Err("JobClassification")</span>
                    </div>
                    <div>
                        <label class="form-lbl">Rate per Day <span class="req-star">*</span></label>
                        <input type="number" name="DailyRate" id="DailyRate" class="@Ctrl("DailyRate")"
                               step="0.01" min="0.01" placeholder="0.00"
                               value="@(Model.DailyRate > 0 ? Model.DailyRate.ToString("0.00") : "")"
                               data-validate="money" data-label="Rate per day" />
                        <span class="field-error" data-error-for="DailyRate">@Err("DailyRate")</span>
                    </div>
                    <div>
                        <label class="form-lbl">Rate per Hour</label>
                        <input type="text" id="RatePerHourDisplay" class="form-ctrl" readonly tabindex="-1"
                               placeholder="0.00"
                               value="@(Model.DailyRate > 0 ? EmployeeRates.HourlyFromDaily(Model.DailyRate).ToString("0.00") : "")" />
                    </div>
                </div>

                <!-- Photo file name -->
                <div class="form-row form-row-1">
                    <div>
                        <label class="form-lbl">Photo</label>
                        <div class="file-row">
                            <label class="file-choose-btn" for="photoInput">Choose File</label>
                            <span class="file-name-lbl" id="fileLabel">
                                @(string.IsNullOrEmpty(Model.PhotoPath)
                                                                ? "No File Chosen"
                                                                : System.IO.Path.GetFileName(Model.PhotoPath))
                            </span>
                        </div>
                        <span class="field-error" data-error-for="photo">@Err("photo")</span>
                    </div>
                </div>

                <button type="submit" class="btn-primary-blue-block">Save Changes</button>

            </div><!-- end edit-fields-col -->
        </div><!-- end edit-layout -->

    </form>

    <!-- Hidden form for toggle submission -->
    <form id="toggleStatusForm" method="post" style="display: none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<!-- Deactivate confirmation overlay (only shown when employee has an assigned project) -->
<div class="del-overlay" id="deactivateEmpOverlay" onclick="closeDeactivateEmpModal(arguments[0])">
    <div class="del-modal">
        <div class="del-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill del-icon"></i>
        </div>
        <div class="del-title">Set as Inactive?</div>
        <div class="del-msg">
            <strong>@Model.FullName</strong> is currently assigned to
            <strong>@assignedProjectName</strong>.
            Marking them as inactive will automatically remove them from this project.
        </div>
        <div class="del-actions">
            <button class="del-btn-cancel" onclick="closeDeactivateEmpModal()">Cancel</button>
            <button class="del-btn-delete" onclick="toggleEmployeeStatus(@Model.EmployeeId)">Set Inactive</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script>
        (function () {
            var daily = document.getElementById('DailyRate');
            var hourly = document.getElementById('RatePerHourDisplay');
            if (!daily || !hourly) return;
            function syncHourly() {
                var n = parseFloat(daily.value);
                hourly.value = (!daily.value || Number.isNaN(n) || n <= 0) ? '' : (n / 8).toFixed(2);
            }
            daily.addEventListener('input', syncHourly);
            daily.addEventListener('change', syncHourly);
            syncHourly();
        })();

        const hasAssignedProject = @(Model.ProjectId.HasValue ? "true" : "false");

        function previewPhoto(input) {
            document.getElementById('fileLabel').textContent =
                input.files.length ? input.files[0].name : 'No File Chosen';

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    let img = document.getElementById('photoPreview');
                    if (!img) {
                        const ph = document.getElementById('photoPreviewPlaceholder');
                        img = document.createElement('img');
                        img.id = 'photoPreview';
                        img.className = 'edit-photo-circle';
                        if (ph) ph.replaceWith(img);
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Called when the employee is currently Active and the button is clicked.
        // Shows a warning first if they're assigned to a project; otherwise toggles directly.
        function confirmToggleStatus(employeeId) {
            if (hasAssignedProject) {
                document.getElementById('deactivateEmpOverlay').classList.add('open');
            } else {
                toggleEmployeeStatus(employeeId);
            }
        }

        function closeDeactivateEmpModal(e) {
            if (!e || e.target === document.getElementById('deactivateEmpOverlay'))
                document.getElementById('deactivateEmpOverlay').classList.remove('open');
        }

        function toggleEmployeeStatus(employeeId) {
            const form = document.getElementById('toggleStatusForm');
            form.action = '/Employee/ToggleStatus/' + employeeId;
            form.submit();
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeDeactivateEmpModal();
        });
    </script>
}