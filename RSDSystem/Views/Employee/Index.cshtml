@using RSDSystem.Helpers
@model IEnumerable<RSDSystem.Models.Employee>
@{
    ViewData["Title"] = "Employee";
    var sortBy = ViewBag.SortBy as string;
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>


<div class="page-card emp-index-card">
    <div class="emp-title mb-3">All Employees</div>

    <div class="list-controls-row">
        <div class="list-controls-left">
            <form asp-action="Index" method="get" class="search-wrap search-wrap-wide">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search Employee" />
                <input type="hidden" name="sortBy" value="@sortBy" />
            </form>
            <div class="dropdown">
                <button class="btn-outline-blue dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Filter
                </button>
                <ul class="dropdown-menu filter-menu">
                    <li>
                        <a class="dropdown-item @(sortBy == "lastname" ? "active" : "")"
                           asp-action="Index" asp-route-sortBy="lastname"
                           asp-route-search="@ViewBag.Search">Last Name</a>
                    </li>
                    <li>
                        <a class="dropdown-item @(sortBy == "job" ? "active" : "")"
                           asp-action="Index" asp-route-sortBy="job"
                           asp-route-search="@ViewBag.Search">Job</a>
                    </li>
                    <li>
                        <a class="dropdown-item @(sortBy == "assigned" ? "active" : "")"
                           asp-action="Index" asp-route-sortBy="assigned"
                           asp-route-search="@ViewBag.Search">Assigned</a>
                    </li>
                    <li>
                        <a class="dropdown-item @(sortBy == "status" ? "active" : "")"
                           asp-action="Index" asp-route-sortBy="status"
                           asp-route-search="@ViewBag.Search">Status</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="list-controls-actions">
            <a asp-action="Create" class="btn-primary-blue">Add Employee</a>
        </div>
    </div>

    <table class="emp-table">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>Employee</th>
                <th>Job</th>
                <th>Assigned to</th>
                <th>Date Added</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No employees found.</td>
                </tr>
            }
            @foreach (var emp in Model)
            {
                var initials = $"{(string.IsNullOrEmpty(emp.FirstName) ? "" : emp.FirstName[..1])}{(string.IsNullOrEmpty(emp.LastName) ? "" : emp.LastName[..1])}";
                var dateAdded = emp.DateAdded.Year > 1900 ? emp.DateAdded.ToString("MMM d, yyyy") : "—";
                <tr>
                    <td>@EmployeeIds.Format(emp.EmployeeCode)</td>
                    <td>
                        <div class="emp-name-cell">
                            @if (!string.IsNullOrEmpty(emp.PhotoPath))
                            {
                                <img src="@emp.PhotoPath" class="emp-avatar" />
                            }
                            else
                            {
                                <span class="emp-avatar-initials">@initials</span>
                            }
                            <span>@emp.FullName</span>
                        </div>
                    </td>
                    <td>@emp.JobClassification</td>
                    <td>@(string.IsNullOrWhiteSpace(emp.Project?.ProjectName) ? "—" : emp.Project.ProjectName)</td>
                    <td>@dateAdded</td>
                    <td>
                        @if (emp.IsActive)
                        {
                            <span class="badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>
                        <div class="action-cell">
                            <a asp-action="Edit" asp-route-id="@emp.EmployeeId"
                               class="action-btn action-edit" title="Edit">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination")
</div>
