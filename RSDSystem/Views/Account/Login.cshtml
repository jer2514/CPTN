@*
    Public login. Posts to Account/Login. Demo users (if seeded): demo / Demo@123 (Admin),
    payroll / Payroll@123 (PayrollStaff). Uses _AuthLayout (no sidebar).
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    var returnUrl = ViewBag.ReturnUrl as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="login-page">
    <div class="login-card">

        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">

            @Html.AntiForgeryToken()

            <div class="logo-wrap">
                <img src="~/Uploads/Images/RSDLogo.png" alt="RSD Logo" class="login-logo" />
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger" role="alert" style="
                            background:#fde8e8;
                            color:#c0392b;
                            border:1.5px solid #fecaca;
                            border-radius:8px;
                            padding:10px 16px;
                            font-size:13px;
                            margin-bottom:16px;">
                    @ViewBag.Error
                </div>
            }

            <div class="form-group">
                <label for="Username" class="form-label">Username</label>
                <input id="Username" name="Username" type="text" class="form-ctrl" value="" required />
            </div>

            <div class="form-group">
                <label for="Password" class="form-label">Password</label>
                <div class="password-wrapper">
                    <input id="Password" name="Password" type="password" class="form-ctrl" required />
                    <button type="button" class="pw-toggle" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group mt-1">
                <button type="submit" class="btn-primary-blue-block">Login</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const u = document.querySelector('input[name="Username"]');
            if (u) u.focus();

            const pwInput = document.querySelector('input[name="Password"]');
            const toggle = document.querySelector('.pw-toggle');
            if (toggle && pwInput) {
                toggle.addEventListener('click', function () {
                    const type = pwInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    pwInput.setAttribute('type', type);
                    toggle.classList.toggle('visible', type === 'text');
                });
            }
        })();
    </script>
}