@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    var returnUrl = ViewBag.ReturnUrl as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css?v=7" />
}

<div class="login-page">
    <div class="login-shell">
        <aside class="login-brand">
            <img src="~/Uploads/Images/RSDLogoWhite.png" alt="RSD Construction Services" class="login-logo" />
            <h1 class="login-brand-title">RSD Payroll System</h1>
            <p class="login-brand-copy">Attendance, payroll, and project records for the construction team.</p>
        </aside>

        <section class="login-panel">
            <div class="login-panel-head">
                <h2>Sign in</h2>
                <p>Enter your username and password to continue.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <div class="form-group">
                    <label for="Username" class="form-label">Username</label>
                    <div class="field-wrap">
                        <i class="bi bi-person field-icon"></i>
                        <input id="Username" name="Username" type="text" class="form-ctrl" value="" required autocomplete="username" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="Password" class="form-label">Password</label>
                    <div class="field-wrap password-wrapper">
                        <i class="bi bi-lock field-icon"></i>
                        <input id="Password" name="Password" type="password" class="form-ctrl" required autocomplete="current-password" />
                        <button type="button" class="pw-toggle" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <button type="submit" class="btn-primary-blue-block">Sign in</button>
                <a asp-controller="Account" asp-action="ForgotPassword" class="login-forgot">Forgot password?</a>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const u = document.querySelector('input[name="Username"]');
            if (u) u.focus();

            const pwInput = document.querySelector('input[name="Password"]');
            const toggle = document.querySelector('.pw-toggle');
            if (toggle && pwInput) {
                toggle.addEventListener('click', function () {
                    const hidden = pwInput.getAttribute('type') === 'password';
                    pwInput.setAttribute('type', hidden ? 'text' : 'password');
                    toggle.classList.toggle('visible', hidden);
                    toggle.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
                    toggle.innerHTML = hidden
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            }
        })();
    </script>
}
