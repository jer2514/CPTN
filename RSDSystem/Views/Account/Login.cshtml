@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    var returnUrl = ViewBag.ReturnUrl as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css?v=2" />
}

<div class="login-page">
    <div class="login-card">

        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">

            @Html.AntiForgeryToken()

            <div class="logo-wrap">
                <img src="~/Uploads/Images/RSDLogo.png" alt="RSD Logo" class="login-logo" />
                <div class="login-heading">RSD Payroll System</div>
                <div class="login-sub">Sign in to continue</div>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="login-alert" role="alert">
                    @ViewBag.Error
                </div>
            }

            <div class="form-group">
                <label for="Username" class="form-label">Username</label>
                <input id="Username" name="Username" type="text" class="form-ctrl" value="" required autocomplete="username" />
            </div>

            <div class="form-group">
                <label for="Password" class="form-label">Password</label>
                <div class="password-wrapper">
                    <input id="Password" name="Password" type="password" class="form-ctrl" required autocomplete="current-password" />
                    <button type="button" class="pw-toggle" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group mt-1">
                <button type="submit" class="btn-primary-blue-block">Login</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const u = document.querySelector('input[name="Username"]');
            if (u) u.focus();

            const pwInput = document.querySelector('input[name="Password"]');
            const toggle = document.querySelector('.pw-toggle');
            if (toggle && pwInput) {
                toggle.addEventListener('click', function () {
                    const hidden = pwInput.getAttribute('type') === 'password';
                    pwInput.setAttribute('type', hidden ? 'text' : 'password');
                    toggle.classList.toggle('visible', hidden);
                    toggle.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
                    toggle.innerHTML = hidden
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            }
        })();
    </script>
}
