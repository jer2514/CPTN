@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css?v=7" />
}

<div class="login-page">
    <div class="login-shell">
        <aside class="login-brand">
            <img src="~/Uploads/Images/RSDLogoWhite.png" alt="RSD Construction Services" class="login-logo" />
            <h1 class="login-brand-title">RSD Payroll System</h1>
            <p class="login-brand-copy">
                Enter your username and email. We will send a code to that inbox to confirm it is you.
            </p>
        </aside>

        <section class="login-panel">
            <div class="login-panel-head">
                <h2>Forgot password</h2>
                <p>Enter the username and email on this account. A verification code will be sent to that email.</p>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="login-form js-validate" novalidate>
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <div class="form-group">
                    <label for="Username" class="form-label">Username</label>
                    <div class="field-wrap">
                        <i class="bi bi-person field-icon"></i>
                        <input id="Username" name="Username" type="text" class="@Ctrl("Username")"
                               value="@ViewBag.Username" data-validate="required" data-label="Username"
                               autocomplete="username" />
                    </div>
                    <span class="field-error" data-error-for="Username">@Err("Username")</span>
                </div>

                <div class="form-group">
                    <label for="Email" class="form-label">Email</label>
                    <div class="field-wrap">
                        <i class="bi bi-envelope field-icon"></i>
                        <input id="Email" name="Email" type="email" class="@Ctrl("Email")"
                               value="@ViewBag.Email" data-validate="required|email" data-label="Email"
                               autocomplete="email" />
                    </div>
                    <span class="field-error" data-error-for="Email">@Err("Email")</span>
                </div>

                <button type="submit" class="btn-primary-blue-block">Send code</button>
                <a asp-controller="Account" asp-action="Login" class="btn-back" style="margin-top:16px">
                    <i class="bi bi-arrow-left"></i> Back to sign in
                </a>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
}
