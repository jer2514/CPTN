@model RSDSystem.Models.User
@{
    var isStaff = string.Equals(Model.Role, "PayrollStaff", StringComparison.OrdinalIgnoreCase);
    Layout = isStaff ? "_PayrollStaffLayout" : "_Layout";
    ViewData["Title"] = "Profile";
    var displayRole = isStaff ? "Payroll Staff" : (Model.Role ?? "—");
    var initials = string.Join("", (Model.FullName ?? "")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpper(w[0])));
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var startEditing = !ViewData.ModelState.IsValid;
    var backHref = isStaff
        ? Url.Action("Index", "PayrollStaff")
        : Url.Action("Index", "Home");
}

<div class="content-topbar page-sticky-bar">
    <a href="@backHref" class="btn-back">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <button type="button" class="bell-btn" aria-label="Notifications"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="form-card profile-view-card">
    <div class="profile-view-head">
        <div class="profile-photo-block">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" alt="" class="edit-photo-circle" id="profilePhotoPreview" />
            }
            else
            {
                <div class="edit-photo-initials" id="profilePhotoPlaceholder">@initials</div>
            }
            <form asp-controller="Account" asp-action="UpdatePhoto" method="post" enctype="multipart/form-data" id="profilePhotoForm">
                @Html.AntiForgeryToken()
                <input type="file" id="profilePhotoInput" name="photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
                <button type="button" class="profile-photo-btn" id="profilePhotoBtn">
                    @(string.IsNullOrEmpty(Model.PhotoPath) ? "Add photo" : "Change photo")
                </button>
            </form>
        </div>
        <div>
            <h1 class="profile-view-name">@Model.FullName</h1>
            <div class="profile-view-meta">
                @displayRole
                <span class="profile-view-dot">·</span>
                Staff ID @Dash(Model.UserCode)
            </div>
            <span class="@(Model.IsActive ? "badge-active" : "badge-inactive")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>
    </div>

    <form asp-controller="Account" asp-action="Profile" method="post"
          class="js-validate profile-form@(startEditing ? "" : " is-locked")" novalidate>
        @Html.AntiForgeryToken()

        <div class="profile-view-grid">
            <div>
                <label class="profile-view-label" for="Username">Username <span class="req-star">*</span></label>
                <input id="Username" type="text" name="Username" value="@Model.Username" maxlength="50"
                       class="@Ctrl("Username") profile-edit-field" data-validate="required" data-label="Username"
                       autocomplete="username" @(startEditing ? null : "readonly") />
                <span class="field-error" data-error-for="Username">@Err("Username")</span>
            </div>
            <div>
                <label class="profile-view-label" for="Email">Email <span class="req-star">*</span></label>
                <input id="Email" type="email" name="Email" value="@Model.Email" maxlength="100"
                       class="@Ctrl("Email") profile-edit-field" data-validate="required|email" data-label="Email"
                       autocomplete="email" @(startEditing ? null : "readonly") />
                <span class="field-error" data-error-for="Email">@Err("Email")</span>
            </div>
            <div>
                <label class="profile-view-label" for="ContactNumber">Contact Number <span class="req-star">*</span></label>
                <input id="ContactNumber" type="text" name="ContactNumber" value="@Model.ContactNumber" maxlength="11"
                       inputmode="numeric" class="@Ctrl("ContactNumber") profile-edit-field"
                       data-validate="required|phone" data-label="Contact number"
                       placeholder="09XXXXXXXXX" @(startEditing ? null : "readonly") />
                <span class="field-error" data-error-for="ContactNumber">@Err("ContactNumber")</span>
            </div>
            <div>
                <div class="profile-view-label">Gender</div>
                <div class="profile-view-value">@Dash(Model.Gender)</div>
            </div>
            <div>
                <div class="profile-view-label">Date of Birth</div>
                <div class="profile-view-value">
                    @(Model.DateOfBirth.HasValue
                        ? Model.DateOfBirth.Value.ToString("MMMM d, yyyy")
                        : "—")
                </div>
            </div>
            <div>
                <div class="profile-view-label">Age</div>
                <div class="profile-view-value">@(Model.Age?.ToString() ?? "—")</div>
            </div>
            <div class="profile-view-wide">
                <label class="profile-view-label" for="Address">Address</label>
                <input id="Address" type="text" name="Address" value="@Model.Address" maxlength="250"
                       class="@Ctrl("Address") profile-edit-field" data-validate="address" data-label="Address"
                       placeholder="Barangay, Municipality/City, Province" @(startEditing ? null : "readonly") />
                <span class="field-error" data-error-for="Address">@Err("Address")</span>
            </div>
        </div>

        <div class="profile-view-actions">
            <button type="button" id="profileEditBtn" class="btn-primary-blue"
                    @(startEditing ? "hidden" : null)>Edit</button>
            <button type="submit" id="profileSaveBtn" class="btn-primary-blue"
                    @(startEditing ? null : "hidden")>Save changes</button>
            <button type="button" id="profileCancelBtn" class="profile-cancel-btn"
                    @(startEditing ? null : "hidden")>Cancel</button>
            <a asp-controller="Account" asp-action="ChangePassword" class="btn-outline-blue">
                <i class="bi bi-key-fill"></i> Change Password
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script>
        (function () {
            const form = document.querySelector('.profile-form');
            if (!form) return;
            const editBtn = document.getElementById('profileEditBtn');
            const saveBtn = document.getElementById('profileSaveBtn');
            const cancelBtn = document.getElementById('profileCancelBtn');
            const fields = form.querySelectorAll('.profile-edit-field');

            function setEditing(on) {
                form.classList.toggle('is-locked', !on);
                fields.forEach(function (field) {
                    if (on) field.removeAttribute('readonly');
                    else field.setAttribute('readonly', 'readonly');
                });
                if (editBtn) editBtn.hidden = on;
                if (saveBtn) saveBtn.hidden = !on;
                if (cancelBtn) cancelBtn.hidden = !on;
                if (on) {
                    const first = form.querySelector('.profile-edit-field');
                    if (first) first.focus();
                }
            }

            if (editBtn) editBtn.addEventListener('click', function () { setEditing(true); });
            if (cancelBtn) cancelBtn.addEventListener('click', function () { window.location.reload(); });
            form.addEventListener('submit', function (e) {
                if (form.classList.contains('is-locked')) e.preventDefault();
            });

            const photoForm = document.getElementById('profilePhotoForm');
            const photoInput = document.getElementById('profilePhotoInput');
            const photoBtn = document.getElementById('profilePhotoBtn');
            if (photoBtn && photoInput && photoForm) {
                photoBtn.addEventListener('click', function () { photoInput.click(); });
                photoInput.addEventListener('change', function () {
                    if (photoInput.files && photoInput.files.length > 0)
                        photoForm.submit();
                });
            }
        })();
    </script>
}
