@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify Email";
    var masked = ViewBag.MaskedEmail as string ?? "your email";
    var displayCode = ViewBag.DisplayCode as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css?v=7" />
}

<div class="login-page">
    <div class="login-shell">
        <aside class="login-brand">
            <img src="~/Uploads/Images/RSDLogoWhite.png" alt="RSD Construction Services" class="login-logo" />
            <h1 class="login-brand-title">RSD Payroll System</h1>
            <p class="login-brand-copy">
                We sent a code to your email so we can confirm it is really you.
            </p>
        </aside>

        <section class="login-panel">
            <div class="login-panel-head">
                <h2>Check your email</h2>
                <p>Enter the 6-digit code sent to <strong>@masked</strong>.</p>
            </div>

            @if (!string.IsNullOrEmpty(displayCode))
            {
                <div class="login-info" role="status">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        SMTP email is not set yet, so the code is shown here:
                        <strong class="login-code-fallback">@displayCode</strong>.
                        After you add Gmail SMTP in appsettings, this code will only arrive in your inbox.
                    </span>
                </div>
            }

            <form asp-controller="Account" asp-action="VerifyResetCode" method="post" class="login-form js-validate" novalidate>
                @Html.AntiForgeryToken()

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(ViewBag.Info))
                {
                    <div class="login-info" role="status">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@ViewBag.Info</span>
                    </div>
                }

                <div class="form-group">
                    <label for="Code" class="form-label">Verification code</label>
                    <div class="field-wrap">
                        <i class="bi bi-shield-lock field-icon"></i>
                        <input id="Code" name="Code" type="text" inputmode="numeric" maxlength="6"
                               class="form-ctrl login-code-input" data-validate="required" data-label="Verification code"
                               autocomplete="one-time-code" />
                    </div>
                </div>

                <button type="submit" class="btn-primary-blue-block">Confirm identity</button>
            </form>

            <form asp-controller="Account" asp-action="VerifyResetCode" method="post" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="resend" value="1" />
                <button type="submit" class="login-forgot" style="background:none;border:none;width:100%;cursor:pointer">
                    Send a new code
                </button>
            </form>

            <a asp-controller="Account" asp-action="ForgotPassword" class="btn-back" style="margin-top:8px">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </section>
    </div>
</div>
