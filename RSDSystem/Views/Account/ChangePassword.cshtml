@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change Password";
    var forced = ViewBag.Forced is true;
    var isStaff = ViewBag.IsStaff is true;
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css?v=5" />
}

<div class="login-page">
    <div class="login-shell">
        <aside class="login-brand">
            <img src="~/Uploads/Images/RSDLogoWhite.png" alt="RSD Construction Services" class="login-logo" />
            <h1 class="login-brand-title">RSD Payroll System</h1>
            <p class="login-brand-copy">
                @(forced
                    ? "Set a password only you know before opening payroll."
                    : "Update the password for this login.")
            </p>
        </aside>

        <section class="login-panel">
            <div class="login-panel-head">
                <h2>@(forced ? "Create your password" : "Change password")</h2>
                <p>
                    @(forced
                        ? "Admin gave you a temporary password. Choose a new one so they can no longer sign in as you."
                        : "Enter your current password, then choose a new one.")
                </p>
            </div>

            <form asp-controller="Account" asp-action="ChangePassword" method="post" class="login-form js-validate" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Current password</label>
                    <div class="field-wrap password-wrapper">
                        <i class="bi bi-lock field-icon"></i>
                        <input type="password" name="CurrentPassword" id="CurrentPassword" class="@Ctrl("CurrentPassword")"
                               data-validate="required" data-label="Current password" autocomplete="current-password" />
                        <button type="button" class="pw-toggle" data-target="CurrentPassword" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span class="field-error" data-error-for="CurrentPassword">@Err("CurrentPassword")</span>
                </div>

                <div class="form-group">
                    <label class="form-label">New password</label>
                    <div class="field-wrap password-wrapper">
                        <i class="bi bi-lock field-icon"></i>
                        <input type="password" name="NewPassword" id="NewPassword" class="@Ctrl("NewPassword")"
                               data-validate="@(isStaff ? "required|staffPassword" : "required|minlen8")"
                               data-label="New password" autocomplete="new-password" />
                        <button type="button" class="pw-toggle" data-target="NewPassword" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span class="field-error" data-error-for="NewPassword">@Err("NewPassword")</span>
                    @if (isStaff)
                    {
                        <div style="color:#9ab0d8;font-size:12px;margin-top:4px">
                            Must include 1 capital letter, 1 number, and 1 special character.
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm new password</label>
                    <div class="field-wrap password-wrapper">
                        <i class="bi bi-lock field-icon"></i>
                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="@Ctrl("ConfirmPassword")"
                               data-validate="required|match" data-match="NewPassword"
                               data-label="Confirm password" autocomplete="new-password" />
                        <button type="button" class="pw-toggle" data-target="ConfirmPassword" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span class="field-error" data-error-for="ConfirmPassword">@Err("ConfirmPassword")</span>
                </div>

                <button type="submit" class="btn-primary-blue-block">Save password</button>

                @if (!forced)
                {
                    <a class="btn-back" style="margin-top:16px" asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Logout" class="btn-back" style="margin-top:16px">
                        <i class="bi bi-box-arrow-right"></i> Sign out
                    </a>
                }
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script>
        document.querySelectorAll('.pw-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                const input = document.getElementById(toggle.getAttribute('data-target'));
                if (!input) return;
                const hidden = input.getAttribute('type') === 'password';
                input.setAttribute('type', hidden ? 'text' : 'password');
                toggle.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
                toggle.innerHTML = hidden
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
            });
        });
    </script>
}
