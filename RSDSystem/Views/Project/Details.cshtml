@model RSDSystem.Models.Project
@{
    ViewData["Title"] = "View Project";
    var employees = ViewBag.Employees as List<RSDSystem.Models.Employee> ?? new();
    var unassigned = ViewBag.UnassignedEmployees as List<RSDSystem.Models.Employee> ?? new();
    var budgets = Model.MonthlyBudgets?.OrderBy(m => m.MonthDate).ToList()
                     ?? new List<RSDSystem.Models.ProjectMonthlyBudget>();
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<a asp-action="Index" class="btn-back">
    <i class="bi bi-arrow-left"></i> Back
</a>

<div class="form-card" style="max-width:680px">

    <div class="proj-view-actions">
        <a asp-action="Edit" asp-route-id="@Model.ProjectId" class="action-btn action-edit" title="Edit">
            <i class="bi bi-pencil-fill"></i>
        </a>
        <button type="button" class="action-btn action-delete" title="Delete"
                onclick="openDeleteModal(@Model.ProjectId, '@Html.Raw(Model.ProjectName.Replace("'", "\\'"))')">
            <i class="bi bi-trash-fill"></i>
        </button>
    </div>

    <div class="proj-view-group">
        <div class="form-lbl">Project Name</div>
        <div class="proj-view-field">@Model.ProjectName</div>
    </div>

    <div class="proj-view-row2">
        <div class="proj-view-group">
            <div class="form-lbl">Location</div>
            <div class="proj-view-field">@(Model.Location ?? "—")</div>
        </div>
        <div class="proj-view-group">
            <div class="form-lbl">Type of Project</div>
            <div class="proj-view-field">@(Model.TypeOfService ?? "—")</div>
        </div>
    </div>

    <div class="proj-view-row2">
        <div class="proj-view-group">
            <div class="form-lbl">Starting Date</div>
            <div class="proj-view-field">@(Model.StartingDate?.ToString("MM/dd/yyyy") ?? "—")</div>
        </div>
        <div class="proj-view-group">
            <div class="form-lbl">Estimate End Date</div>
            <div class="proj-view-field">@(Model.EstimateEndDate?.ToString("MM/dd/yyyy") ?? "—")</div>
        </div>
    </div>

    <div class="proj-view-group">
        <div class="form-lbl">Payroll Budget</div>
        <div class="proj-view-field">
            @(Model.PayrollBudget.HasValue ? "₱" + Model.PayrollBudget.Value.ToString("N2") : "—")
        </div>
    </div>

    <div class="proj-view-group">
        <div class="form-lbl">Monthly Budget</div>
        @if (!budgets.Any())
        {
            <div class="proj-view-field" style="color:#9ab0d8;font-size:12.5px">
                No monthly budget set.
            </div>
        }
        else
        {
            <div class="proj-monthly-table">
                @foreach (var b in budgets)
                {
                    <div class="proj-month-row">
                        <span class="proj-month-label">Month of @b.MonthYear</span>
                        <span class="proj-month-amount">₱@b.Amount.ToString("N2")</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="proj-view-group">
        <div class="form-lbl">Payroll Distribution</div>
        <div class="proj-view-field">@(Model.PayrollDistribution ?? "—")</div>
    </div>

    <div class="proj-view-group">
        <div class="form-lbl">Assigned to Payroll Staff</div>
        <div class="proj-view-field">@(Model.AssignedPayrollStaff ?? "—")</div>
    </div>

    <div class="proj-view-group mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="form-lbl mb-0">Assigned Employees</span>
            <span class="proj-emp-count">
                Total Employees: <strong id="empTotalCount">@employees.Count</strong>
            </span>
        </div>
        <div class="emp-action-btns">
            <button type="button" class="btn-outline-blue" onclick="openViewEmpModal()">
                <i class="bi bi-people-fill"></i> View Employees
            </button>
            <button type="button" class="btn-primary-blue" onclick="openAddEmpModal()">
                <i class="bi bi-person-plus-fill"></i> Add Employees
            </button>
        </div>
    </div>
</div>

<!-- ============ VIEW EMPLOYEES OVERLAY ============ -->
<div class="del-overlay" id="viewEmpOverlay" onclick="closeViewEmpModal(arguments[0])">
    <div class="del-modal emp-modal">
        <div class="emp-modal-head">
            <span class="emp-modal-title">Assigned Employees</span>
            <button type="button" class="emp-modal-close" onclick="closeViewEmpModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="search-wrap emp-search">
            <i class="bi bi-search"></i>
            <input type="text" id="viewEmpSearch" placeholder="Search employee..."
                   onkeyup="filterEmpTable('viewEmpSearch','viewEmpTableBody')" />
        </div>

        <table class="emp-table emp-table-view">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Job</th>
                    <th>Rate</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="viewEmpTableBody">
                @if (!employees.Any())
                {
                    <tr class="empty-row"><td colspan="4" class="text-center text-muted py-3">No employees assigned.</td></tr>
                }
                @foreach (var emp in employees)
                {
                    <tr data-name="@emp.FullName.ToLower()" data-id="@emp.EmployeeId">
                        <td>@emp.FullName</td>
                        <td>@emp.JobClassification</td>
                        <td>₱@emp.DailyRate.ToString("N2")</td>
                        <td>
                            <button type="button"
                                    class="badge-btn @(emp.IsActive ? "badge-active" : "badge-inactive")"
                                    data-id="@emp.EmployeeId"
                                    data-name="@emp.FullName"
                                    onclick="handleStatusClick(this)">
                                @(emp.IsActive ? "Active" : "Inactive")
                            </button>
                        </td>
                    </tr>
                }
                <tr class="no-result-row" style="display:none">
                    <td colspan="4" class="text-center text-muted py-3">No matching employees.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ============ DEACTIVATE CONFIRM OVERLAY ============ -->
<div class="del-overlay" id="deactivateOverlay" onclick="closeDeactivateModal(arguments[0])">
    <div class="del-modal">
        <div class="del-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill del-icon"></i>
        </div>
        <div class="del-title">Set as Inactive?</div>
        <div class="del-msg">
            Marking <strong id="deactivateEmpName"></strong> as inactive will also
            remove them from this project. You can add them back later from
            <strong>Add Employees</strong>.
        </div>
        <div class="del-actions">
            <button class="del-btn-cancel" onclick="closeDeactivateModal()">Cancel</button>
            <button class="del-btn-delete" onclick="confirmDeactivate()">Set Inactive</button>
        </div>
    </div>
</div>

<!-- ============ ADD EMPLOYEES OVERLAY ============ -->
<div class="del-overlay" id="addEmpOverlay" onclick="closeAddEmpModal(arguments[0])">
    <div class="del-modal emp-modal">
        <div class="emp-modal-head">
            <span class="emp-modal-title">Add Employees</span>
            <button type="button" class="emp-modal-close" onclick="closeAddEmpModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="search-wrap emp-search">
            <i class="bi bi-search"></i>
            <input type="text" id="addEmpSearch" placeholder="Search employee..."
                   onkeyup="filterEmpTable('addEmpSearch','addEmpTableBody')" />
        </div>

        <table class="emp-table emp-table-add">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Job</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="addEmpTableBody">
                @if (!unassigned.Any())
                {
                    <tr class="empty-row"><td colspan="3" class="text-center text-muted py-3">No available employees.</td></tr>
                }
                @foreach (var emp in unassigned)
                {
                    <tr data-name="@emp.FullName.ToLower()" data-id="@emp.EmployeeId">
                        <td>@emp.FullName</td>
                        <td>@emp.JobClassification</td>
                        <td class="text-end">
                            <button type="button" class="add-emp-btn" data-id="@emp.EmployeeId"
                                    onclick="assignEmployee(this)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
                <tr class="no-result-row" style="display:none">
                    <td colspan="3" class="text-center text-muted py-3">No matching employees.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Hidden token source for AJAX calls -->
<form id="tokenForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="del-overlay" id="deleteOverlay" onclick="closeDeleteModal(arguments[0])">
    <div class="del-modal">
        <div class="del-icon-wrap">
            <i class="bi bi-exclamation-triangle-fill del-icon"></i>
        </div>
        <div class="del-title">Are you sure?</div>
        <div class="del-msg">
            You are about to permanently delete project:
            <strong id="deleteProjName"></strong>.
            This action cannot be undone.
        </div>
        <div class="del-actions">
            <button class="del-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="del-btn-delete">Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const PROJECT_ID = @Model.ProjectId;
        let pendingDeactivate = null;

        function getToken() {
            return document.querySelector('#tokenForm input[name="__RequestVerificationToken"]').value;
        }

        // ── Delete project modal ──────────────────────────
        function openDeleteModal(id, name) {
            document.getElementById('deleteProjName').textContent = name;
            document.getElementById('deleteForm').action = '/Project/Delete/' + id;
            document.getElementById('deleteOverlay').classList.add('open');
        }
        function closeDeleteModal(e) {
            if (!e || e.target === document.getElementById('deleteOverlay'))
                document.getElementById('deleteOverlay').classList.remove('open');
        }

        // ── View Employees modal ──────────────────────────
        function openViewEmpModal() {
            document.getElementById('viewEmpOverlay').classList.add('open');
        }
        function closeViewEmpModal(e) {
            if (!e || e.target === document.getElementById('viewEmpOverlay'))
                document.getElementById('viewEmpOverlay').classList.remove('open');
        }

        // ── Add Employees modal ───────────────────────────
        function openAddEmpModal() {
            document.getElementById('addEmpOverlay').classList.add('open');
        }
        function closeAddEmpModal(e) {
            if (!e || e.target === document.getElementById('addEmpOverlay'))
                document.getElementById('addEmpOverlay').classList.remove('open');
        }

        // ── Deactivate confirm modal ───────────────────────
        function closeDeactivateModal(e) {
            if (!e || e.target === document.getElementById('deactivateOverlay')) {
                document.getElementById('deactivateOverlay').classList.remove('open');
                pendingDeactivate = null;
            }
        }

        // ── Search filter (shared by both modals) ─────────
        function filterEmpTable(inputId, tbodyId) {
            const term = document.getElementById(inputId).value.trim().toLowerCase();
            const tbody = document.getElementById(tbodyId);
            const rows = tbody.querySelectorAll('tr[data-name]');
            let visibleCount = 0;

            rows.forEach(r => {
                const match = r.dataset.name.includes(term);
                r.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            const noResult = tbody.querySelector('.no-result-row');
            if (noResult) noResult.style.display = visibleCount === 0 ? '' : 'none';
        }

        function clearEmptyRow(tbody) {
            const empty = tbody.querySelector('.empty-row');
            if (empty) empty.remove();
        }

        function addEmptyRowIfNeeded(tbody, colspan, message) {
            if (!tbody.querySelector('tr[data-name]') && !tbody.querySelector('.empty-row')) {
                tbody.insertAdjacentHTML('afterbegin',
                    `<tr class="empty-row"><td colspan="${colspan}" class="text-center text-muted py-3">${message}</td></tr>`);
            }
        }

        // ── Status badge click — routes based on current state ─
        function handleStatusClick(btn) {
            const isActive = btn.classList.contains('badge-active');
            const employeeId = btn.dataset.id;

            if (isActive) {
                pendingDeactivate = { btn: btn, employeeId: employeeId };
                document.getElementById('deactivateEmpName').textContent = btn.dataset.name;
                document.getElementById('deactivateOverlay').classList.add('open');
            } else {
                activateEmployee(btn, employeeId);
            }
        }

        // ── Inactive → Active (direct, stays in project) ──
        async function activateEmployee(btn, employeeId) {
            btn.disabled = true;
            try {
                const formData = new FormData();
                formData.append('id', employeeId);
                formData.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Employee/ToggleStatusAjax', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success && data.isActive) {
                    btn.classList.remove('badge-inactive');
                    btn.classList.add('badge-active');
                    btn.textContent = 'Active';
                } else if (!data.success) {
                    alert(data.message || 'Could not update status.');
                }
            } catch (err) {
                alert('Something went wrong. Please try again.');
            } finally {
                btn.disabled = false;
            }
        }

        // ── Active → Inactive (confirmed): deactivate + remove ──
        async function confirmDeactivate() {
            if (!pendingDeactivate) return;
            const btn = pendingDeactivate.btn;
            const employeeId = pendingDeactivate.employeeId;

            btn.disabled = true;

            try {
                const formData = new FormData();
                formData.append('employeeId', employeeId);
                formData.append('projectId', PROJECT_ID);
                formData.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Project/DeactivateAndRemove', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success) {
                    const viewBody = document.getElementById('viewEmpTableBody');
                    btn.closest('tr').remove();
                    addEmptyRowIfNeeded(viewBody, 4, 'No employees assigned.');

                    const addBody = document.getElementById('addEmpTableBody');
                    clearEmptyRow(addBody);

                    const tr = document.createElement('tr');
                    tr.dataset.name = data.employee.name.toLowerCase();
                    tr.dataset.id = data.employee.id;
                    tr.innerHTML = '<td>' + data.employee.name + '</td>' +
                        '<td>' + data.employee.job + '</td>' +
                        '<td class="text-end"><button type="button" class="add-emp-btn" data-id="' + data.employee.id + '" onclick="assignEmployee(this)">Add</button></td>';
                    addBody.insertBefore(tr, addBody.querySelector('.no-result-row'));

                    const countEl = document.getElementById('empTotalCount');
                    countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
                } else {
                    alert(data.message || 'Could not update employee.');
                    btn.disabled = false;
                }
            } catch (err) {
                alert('Something went wrong. Please try again.');
                btn.disabled = false;
            }

            closeDeactivateModal();
        }

        // ── Add employee via AJAX ──────────────────────────
        async function assignEmployee(btn) {
            const employeeId = btn.dataset.id;
            btn.disabled = true;
            btn.textContent = 'Adding...';

            try {
                const formData = new FormData();
                formData.append('employeeId', employeeId);
                formData.append('projectId', PROJECT_ID);
                formData.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Project/AssignEmployee', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success) {
                    const addBody = document.getElementById('addEmpTableBody');
                    btn.closest('tr').remove();
                    addEmptyRowIfNeeded(addBody, 3, 'No available employees.');

                    const viewBody = document.getElementById('viewEmpTableBody');
                    clearEmptyRow(viewBody);

                    const tr = document.createElement('tr');
                    tr.dataset.name = data.employee.name.toLowerCase();
                    tr.dataset.id = data.employee.id;
                    const statusClass = data.employee.status === 'Active' ? 'badge-active' : 'badge-inactive';
                    tr.innerHTML = '<td>' + data.employee.name + '</td>' +
                        '<td>' + data.employee.job + '</td>' +
                        '<td>₱' + data.employee.rate + '</td>' +
                        '<td><button type="button" class="badge-btn ' + statusClass + '" data-id="' + data.employee.id + '" data-name="' + data.employee.name + '" onclick="handleStatusClick(this)">' + data.employee.status + '</button></td>';
                    viewBody.insertBefore(tr, viewBody.querySelector('.no-result-row'));

                    const countEl = document.getElementById('empTotalCount');
                    countEl.textContent = parseInt(countEl.textContent) + 1;
                } else {
                    alert(data.message || 'Could not add employee.');
                    btn.disabled = false;
                    btn.textContent = 'Add';
                }
            } catch (err) {
                alert('Something went wrong. Please try again.');
                btn.disabled = false;
                btn.textContent = 'Add';
            }
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                closeDeleteModal();
                closeViewEmpModal();
                closeAddEmpModal();
                closeDeactivateModal();
            }
        });
    </script>
}