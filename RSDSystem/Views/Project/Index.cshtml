@model IEnumerable<RSDSystem.Models.Project>
@{
    ViewData["Title"] = "Projects";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string ?? ProjectStatusOptions.OnGoing;
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<div class="page-card">
    <div class="emp-title mb-3">Projects</div>

    <div class="list-controls-row">
        <div class="list-controls-actions">
            <form asp-action="Index" method="get" class="search-wrap search-wrap-wide">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@search" placeholder="Search Project" />
                <input type="hidden" name="status" value="@status" />
            </form>
            <div class="dropdown">
                <button class="btn-outline-blue dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <ul class="dropdown-menu filter-menu">
                    @foreach (var option in ProjectStatusOptions.All)
                    {
                        <li>
                            @if (status == option)
                            {
                                <a class="dropdown-item active"
                                   asp-action="Index"
                                   asp-route-status="@option"
                                   asp-route-search="@search">@option</a>
                            }
                            else
                            {
                                <a class="dropdown-item"
                                   asp-action="Index"
                                   asp-route-status="@option"
                                   asp-route-search="@search">@option</a>
                            }
                        </li>
                    }
                </ul>
            </div>
            <a asp-action="Create" class="btn-primary-blue">Add Project</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-folder2" style="font-size:48px;color:#C9DAFF"></i>
            <div class="mt-2" style="font-size:13px">
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <text>No matching @status projects.</text>
                }
                else
                {
                    <text>No @status projects. Click Add Project to get started, or choose another filter.</text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="proj-grid">
            @foreach (var p in Model)
            {
                <div class="proj-folder-card">
                    <a asp-action="Details" asp-route-id="@p.ProjectId"
                       class="proj-folder-link" title="View Project">
                        <div class="proj-folder-icon">
                            <svg width="64" height="54" viewBox="0 0 64 54" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M0 8C0 3.58 3.58 0 8 0H24L30 8H56C60.42 8 64 11.58 64 16V46C64 50.42 60.42 54 56 54H8C3.58 54 0 50.42 0 46V8Z"
                                      fill="#C9DAFF" />
                                <path d="M0 16H64V46C64 50.42 60.42 54 56 54H8C3.58 54 0 50.42 0 46V16Z"
                                      fill="#A8C4FF" />
                            </svg>
                        </div>
                        <div class="proj-folder-name">@p.ProjectName</div>
                    </a>
                </div>
            }
        </div>
    }
</div>
