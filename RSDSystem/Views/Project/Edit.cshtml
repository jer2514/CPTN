@model RSDSystem.Models.Project
@{
    ViewData["Title"] = "Edit Project";
    var services = ViewBag.TypeOfServiceOptions as string[] ?? Array.Empty<string>();
    var distros = ViewBag.DistributionOptions as string[] ?? Array.Empty<string>();
    var staffList = ViewBag.PayrollStaffList as List<string> ?? new List<string>();
    var employees = ViewBag.Employees as List<RSDSystem.Models.Employee> ?? new();
    var postedYears = ViewBag.MonthYears as List<string>;
    var postedAmounts = ViewBag.MonthAmounts as List<decimal> ?? new List<decimal>();
    var existingBudgets = Model.MonthlyBudgets?.OrderBy(m => m.MonthDate).ToList()
                           ?? new List<RSDSystem.Models.ProjectMonthlyBudget>();
    string Ctrl(string name) => ViewData.ModelState[name]?.Errors.Count > 0 ? "form-ctrl is-invalid" : "form-ctrl";
    string Err(string name) => ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    var generalErrors = ViewData.ModelState
        .Where(kv => string.IsNullOrEmpty(kv.Key))
        .SelectMany(kv => kv.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .ToList();
}


<div class="content-topbar">
    <button class="bell-btn"><i class="bi bi-bell-fill"></i></button>
</div>

<a asp-action="Index" class="btn-back">
    <i class="bi bi-arrow-left"></i> Back
</a>

<div class="form-card">
    <form asp-action="Edit" method="post" class="js-validate" novalidate>
        @Html.AntiForgeryToken()
        @if (generalErrors.Count > 0)
        {
            <div class="form-error-box">
                @foreach (var err in generalErrors)
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }
        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />

        <!-- Project Name -->
        <div class="form-row form-row-1">
            <div>
                <label class="form-lbl">Project Name <span class="req-star">*</span></label>
                <input type="text" name="ProjectName" value="@Model.ProjectName" maxlength="150"
                       class="@Ctrl("ProjectName")" data-validate="required|projectName" data-label="Project name" />
                <span class="field-error" data-error-for="ProjectName">@Err("ProjectName")</span>
            </div>
        </div>

        <!-- Location | Type of Service -->
        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Location <span class="req-star">*</span></label>
                <input type="text" name="Location" value="@Model.Location" maxlength="250"
                       class="@Ctrl("Location")" data-validate="required|address" data-label="Location"
                       placeholder="Barangay, Municipality/City, Province" />
                <span class="field-error" data-error-for="Location">@Err("Location")</span>
            </div>
            <div>
                <label class="form-lbl">Type of Service <span class="req-star">*</span></label>
                <select name="TypeOfService" class="@Ctrl("TypeOfService")"
                        data-validate="required" data-label="Type of service">
                    <option value="">Select type</option>
                    @foreach (var s in services)
                    {
                        if (s == Model.TypeOfService)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
                <span class="field-error" data-error-for="TypeOfService">@Err("TypeOfService")</span>
            </div>
        </div>

        <!-- Starting Date | Estimate End Date -->
        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Starting Date <span class="req-star">*</span></label>
                <input type="date" name="StartingDate" id="startDate"
                       value="@Model.StartingDate?.ToString("yyyy-MM-dd")"
                       min="2000-01-01" max="2099-12-31"
                       class="@Ctrl("StartingDate")" data-validate="required|dateYear" data-label="Starting date"
                       onchange="generateMonthRows()" />
                <span class="field-error" data-error-for="StartingDate">@Err("StartingDate")</span>
            </div>
            <div>
                <label class="form-lbl">Estimate End Date <span class="req-star">*</span></label>
                <input type="date" name="EstimateEndDate" id="endDate"
                       value="@Model.EstimateEndDate?.ToString("yyyy-MM-dd")"
                       min="2000-01-01" max="2099-12-31"
                       class="@Ctrl("EstimateEndDate")" data-validate="required|dateAfter|dateYear" data-after="startDate"
                       data-label="Estimate end date"
                       onchange="generateMonthRows()" />
                <span class="field-error" data-error-for="EstimateEndDate">@Err("EstimateEndDate")</span>
            </div>
        </div>

        <!-- Payroll Budget -->
        <div class="form-row form-row-1">
            <div>
                <label class="form-lbl">Payroll Budget <span class="req-star">*</span></label>
                <div class="proj-budget-input">
                    <span class="proj-peso">₱</span>
                    <input type="number" name="PayrollBudget" class="@Ctrl("PayrollBudget") proj-budget-field"
                           step="0.01" min="0.01" placeholder="0.00"
                           value="@(Model.PayrollBudget > 0 ? Model.PayrollBudget.Value.ToString("0.00") : "")"
                           data-validate="money" data-label="Payroll budget" />
                </div>
                <span class="field-error" data-error-for="PayrollBudget">@Err("PayrollBudget")</span>
            </div>
        </div>

        <!-- Monthly Budget — dynamically generated, pre-filled from existing data -->
        <div class="form-row form-row-1">
            <label class="form-lbl">Monthly Budget <span class="req-star">*</span></label>

            <div id="monthBudgetPlaceholder" class="proj-view-field proj-view-field-muted"
                 style="@(existingBudgets.Any() ? "display:none" : "")">
                Select starting and estimate end dates to generate monthly budget rows.
            </div>

            <div id="monthBudgetSection" style="@(existingBudgets.Any() ? "" : "display:none")">
                <div class="proj-monthly-table">
                    <div id="monthRowsContainer">
                        @foreach (var b in existingBudgets)
                        {
                            <div class="proj-month-row">
                                <span class="proj-month-label">Month of @b.MonthYear</span>
                                <div class="proj-budget-input proj-month-input">
                                    <span class="proj-peso">₱</span>
                                    <input type="number" name="MonthAmounts"
                                           class="form-ctrl proj-budget-field"
                                           step="0.01" min="0"
                                           value="@b.Amount" placeholder="0.00" />
                                    <input type="hidden" name="MonthYears"
                                           value="@b.MonthDate.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="text-end" style="padding:8px 14px">
                        <button type="button" class="btn-save-budget" onclick="confirmBudget()">
                            Save Budget
                        </button>
                    </div>
                </div>
            </div>
            <span class="field-error" data-error-for="MonthlyBudget">@Err("MonthlyBudget")</span>
        </div>

        <!-- Payroll Distribution -->
        <div class="form-row form-row-1">
            <div>
                <label class="form-lbl">Payroll Distribution <span class="req-star">*</span></label>
                <select name="PayrollDistribution" class="@Ctrl("PayrollDistribution")"
                        data-validate="required" data-label="Payroll distribution">
                    <option value="">Select distribution</option>
                    @foreach (var d in distros)
                    {
                        if (d == Model.PayrollDistribution)
                        {
                            <option value="@d" selected>@d</option>
                        }
                        else
                        {
                            <option value="@d">@d</option>
                        }
                    }
                </select>
                <span class="field-error" data-error-for="PayrollDistribution">@Err("PayrollDistribution")</span>
            </div>
        </div>

        <!-- Assigned to Payroll Staff | Status -->
        <div class="form-row form-row-2">
            <div>
                <label class="form-lbl">Assigned to Payroll Staff <span class="req-star">*</span></label>
                <select name="AssignedPayrollStaff" class="@Ctrl("AssignedPayrollStaff")"
                        data-validate="required" data-label="Assigned payroll staff">
                    <option value="">Select payroll staff</option>
                    @foreach (var staff in staffList)
                    {
                        if (staff == Model.AssignedPayrollStaff)
                        {
                            <option value="@staff" selected>@staff</option>
                        }
                        else
                        {
                            <option value="@staff">@staff</option>
                        }
                    }
                </select>
                <span class="field-error" data-error-for="AssignedPayrollStaff">@Err("AssignedPayrollStaff")</span>
            </div>
            <div>
                <label class="form-lbl">Status</label>
                <select name="Status" class="form-ctrl">
                    @foreach (var status in ProjectStatusOptions.All)
                    {
                        if (ProjectStatusOptions.Normalize(Model.Status) == status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Assigned Employees Table -->
        <div class="proj-view-group mt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="form-lbl mb-0">Assigned Employees</span>
                <span class="proj-emp-count">
                    Total Employees: <strong>@employees.Count</strong>
                </span>
            </div>
            <table class="emp-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Job</th>
                        <th>Rate</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!employees.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">
                                No employees assigned.
                            </td>
                        </tr>
                    }
                    @foreach (var emp in employees)
                    {
                        <tr>
                            <td>@emp.FullName</td>
                            <td>@emp.JobClassification</td>
                            <td>₱@emp.DailyRate.ToString("N2")</td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Employee" asp-action="Edit"
                                   asp-route-id="@emp.EmployeeId"
                                   class="action-btn action-edit" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <button type="button" class="action-btn action-delete" title="Remove"
                                        onclick="removeEmployee(@emp.EmployeeId)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn-primary-blue-block mt-3">Save Changes</button>
    </form>

    <!-- Hidden form for employee removal to avoid nested form issue -->
    <form id="removeEmployeeForm" asp-action="RemoveEmployee" method="post" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" id="removeEmpId" />
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
    </form>
</div>

@section Scripts {
    <partial name="_FormValidationScripts" />
    <script>
        function isUsableProjectDate(iso) {
            if (!iso) return false;
            const yearPart = String(iso).split('-')[0] || '';
            const year = parseInt(yearPart, 10);
            if (yearPart.length !== 4 || Number.isNaN(year) || year < 2000 || year > 2099) return false;
            const dt = new Date(iso + 'T00:00:00');
            return !Number.isNaN(dt.getTime());
        }

        function generateMonthRows() {
            const start = document.getElementById('startDate').value;
            const end   = document.getElementById('endDate').value;
            const container = document.getElementById('monthRowsContainer');
            const section    = document.getElementById('monthBudgetSection');
            const placeholder= document.getElementById('monthBudgetPlaceholder');

            if (!start || !end) return;
            if (!isUsableProjectDate(start) || !isUsableProjectDate(end)) return;

            const startDt = new Date(start + 'T00:00:00');
            const endDt   = new Date(end + 'T00:00:00');

            if (startDt > endDt) {
                const dest = document.querySelector('[data-error-for="EstimateEndDate"]');
                if (dest) dest.textContent = 'Estimate end date must be on or after the starting date.';
                document.getElementById('endDate').classList.add('is-invalid');
                return;
            }

            container.innerHTML = '';

            const current   = new Date(startDt.getFullYear(), startDt.getMonth(), 1);
            const lastMonth = new Date(endDt.getFullYear(), endDt.getMonth(), 1);
            let safety = 0;

            while (current <= lastMonth && safety < 120) {
                safety++;
                const monthName = current.toLocaleString('default', { month: 'long' });
                const year       = current.getFullYear();
                const isoDate    = current.getFullYear() + '-' +
                                    String(current.getMonth() + 1).padStart(2, '0') + '-01';

                const row = document.createElement('div');
                row.className = 'proj-month-row';
                row.innerHTML = `
                    <span class="proj-month-label">Month of ${monthName} ${year}</span>
                    <div class="proj-budget-input proj-month-input">
                        <span class="proj-peso">₱</span>
                        <input type="number" name="MonthAmounts"
                               class="form-ctrl proj-budget-field"
                               step="0.01" min="0" placeholder="0.00" />
                        <input type="hidden" name="MonthYears" value="${isoDate}" />
                    </div>`;
                container.appendChild(row);

                current.setMonth(current.getMonth() + 1);
            }

            section.style.display = 'block';
            placeholder.style.display = 'none';
        }

        function confirmBudget() {
            const dest = document.querySelector('[data-error-for="MonthlyBudget"]');
            const amounts = document.querySelectorAll('input[name="MonthAmounts"]');
            if (amounts.length === 0) {
                if (dest) dest.textContent = 'Select starting and estimate end dates to generate monthly budget rows.';
                return;
            }
            if (monthlyTotalExceedsPayrollBudget()) {
                if (dest) dest.textContent = 'Monthly budget total cannot exceed the payroll budget.';
                showToast('Monthly budget total cannot exceed the payroll budget.');
                return;
            }
            if (dest) dest.textContent = '';
            showToast('Monthly budget updated. It will be submitted with the project.', 'success');
        }

        function payrollBudgetValue() {
            const el = document.querySelector('input[name="PayrollBudget"]');
            if (!el || el.value === '') return NaN;
            return parseFloat(el.value);
        }

        function monthlyBudgetTotal() {
            return Array.from(document.querySelectorAll('input[name="MonthAmounts"]'))
                .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
        }

        function monthlyTotalExceedsPayrollBudget() {
            const payroll = payrollBudgetValue();
            if (!Number.isFinite(payroll)) return false;
            return monthlyBudgetTotal() > payroll + 0.001;
        }

        document.querySelector('form.js-validate')?.addEventListener('submit', function (e) {
            const dest = document.querySelector('[data-error-for="MonthlyBudget"]');
            if (monthlyTotalExceedsPayrollBudget()) {
                e.preventDefault();
                if (dest) dest.textContent = 'Monthly budget total cannot exceed the payroll budget.';
                showToast('Monthly budget total cannot exceed the payroll budget.');
            }
        });

        function removeEmployee(id) {
            if (confirm('Remove this employee from project?')) {
                document.getElementById('removeEmpId').value = id;
                document.getElementById('removeEmployeeForm').submit();
            }
        }
    </script>
}
